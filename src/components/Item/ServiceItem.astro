---
/**
 * One service in the list on the homepage and /about: the name on the left,
 * its label in the middle, and the arrow button pinned to the right edge.
 * The export's `.service-list-item` row, verbatim, bound to the
 * `SERVICES_LIST_QUERY` projection from `utils/sanity.ts`.
 *
 * Hovering the row draws its two ends toward each other — the title shifts
 * right, the arrow button left — and flips the button's colours, so the dark
 * circle with the accent arrow becomes an accent circle with a dark one. The
 * arrow's own roll-over comes with it: `.icon-button` fires that from the
 * button, which on a row this wide only caught a cursor already on the
 * circle, so it is re-fired from the row and the three move as one.
 */
type Props = {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** A service, as projected by `SERVICES_LIST_QUERY`. */
  service: {
    title?: string | null;
    slug?: string | null;
    label?: string | null;
  };
};

const { render = true, service: s } = Astro.props;

const arrow = `<svg width="100%" height="100%" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M18.666 25.332L27.9993 15.9987L18.666 6.66536" stroke="currentcolor" stroke-width="1.5" stroke-miterlimit="10"></path>
  <path d="M27.9993 16L2.66602 16" stroke="currentcolor" stroke-width="1.5" stroke-miterlimit="10"></path>
</svg>`;
---

{
  render && s.slug && (
    <div role="listitem" class="service-container fade-in-bottom w-dyn-item">
      <a href={`/service/${s.slug}`} class="service-list-item w-inline-block">
        <div class="w-layout-grid _12-column-grid list-grid">
          <h3 class="text-2xl text-regular service-cell-title">{s.title}</h3>
          <p class="service-cell-label">{s.label}</p>
          <div class="icon-button service-cell-arrow">
            <div class="button-arrow second-arrow w-embed" set:html={arrow} />
            <div class="button-arrow w-embed" set:html={arrow} />
          </div>
        </div>
      </a>
    </div>
  )
}

<style is:global>
  @layer components {
    /* One distance for both ends, so they always travel together.
       `--service-item-roll` is how far the arrows fall for the second to land
       where the first rests: `.second-arrow` is parked at `top: -42px` and the
       resting arrow is centred at 18px in the 4rem circle, so 60px. IX2 moved
       them 42px, which leaves the incoming arrow 18px high — invisible while
       the roll only fired from the circle itself, obvious now the whole row
       fires it. */
    .service-list-item {
      --service-item-shift: 0.75rem;
      --service-item-roll: 3.75rem;
    }

    .service-list-item .service-cell-title {
      transition: transform var(--hover-duration) var(--hover-ease);
    }

    /* Two classes on the arrow rules, to outrank the `.icon-button
       .button-arrow` transition `SectionHeroHome` sets on every arrow button
       on the page — that one covers `transform` only, and these need the
       colours with it. */
    .service-list-item .service-cell-arrow,
    .service-list-item .service-cell-arrow .button-arrow {
      transition:
        transform var(--hover-duration) var(--hover-ease),
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
    }

    .service-list-item:focus-visible .service-cell-title {
      transform: translateX(var(--service-item-shift));
    }

    .service-list-item:focus-visible .service-cell-arrow {
      transform: translateX(calc(var(--service-item-shift) * -1));
      background-color: var(--accent);
    }

    /* Three classes, so the roll follows the row rather than the button:
       `SectionHeroHome` fires it from `.icon-button:hover`, which on a row
       this wide only caught a cursor already on the circle. */
    .service-list-item:focus-visible .service-cell-arrow .button-arrow {
      color: var(--black);
      transform: translateY(var(--service-item-roll));
    }

    @media (hover: hover) {
      .service-list-item:hover .service-cell-title {
        transform: translateX(var(--service-item-shift));
      }

      .service-list-item:hover .service-cell-arrow {
        transform: translateX(calc(var(--service-item-shift) * -1));
        background-color: var(--accent);
      }

      .service-list-item:hover .service-cell-arrow .button-arrow {
        color: var(--black);
        transform: translateY(var(--service-item-roll));
      }
    }

    /* The colour swap still reads without the movement. Below 992px only the
       shift goes: the row stacks with the arrow at the start, so there is no
       opposing edge to move toward, but the roll is unaffected by the stack. */
    @media screen and (max-width: 991px) {
      .service-list-item {
        --service-item-shift: 0rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .service-list-item {
        --service-item-shift: 0rem;
        --service-item-roll: 0rem;
      }
    }
  }
</style>
