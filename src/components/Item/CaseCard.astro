---
/**
 * One case in a list — the homepage, `/work`, a service page's related cases,
 * and the "next case" on a case page. The export's `.case` item, verbatim,
 * bound to the `caseCardFields` projection from `utils/sanity.ts`.
 *
 * The hover is the export's IX2 "Featured Case Hover" (`a-58`/`a-59`, bound by
 * `e-181`/`e-198`/`e-217`/`e-220` to the thumbnail frame on every page that
 * listed cases) plus "View Cirlce Move" (`a-54`, the `MOUSE_MOVE` continuous
 * action on the same element — the export's name, from when the mark was a
 * circle; it is a signal-green square now). Three things happen at once:
 *
 *   - the title and service rise 8px (250ms, outSine, both ways)
 *   - the thumbnail scales to 1.05 and dims to 0.8 (500ms/250ms in,
 *     550ms out, outSine and inOutQuad)
 *   - the "View" square fades in over 50ms (inOutQuart) and scales 0.6 → 1
 *     over 150ms (outSine), then trails the pointer across the frame
 *
 * All of it is CSS but the trailing square, which needs a frame loop. IX2 gave
 * it ±60px of travel on each axis, measured against the frame's own bounds,
 * with `smoothing: 95` and `restingState: 50` — a 0.05 lerp toward the pointer
 * each frame, settling at centre. The script below is that, made frame-rate
 * independent so it feels the same on a 120Hz display, and skipped entirely
 * under `prefers-reduced-motion` (IX2 ignored the setting).
 *
 * `.view-square-track` is the one element the export did not have. The square
 * cannot both follow the pointer and transition its scale off a single
 * `transform`, so the track carries the follow and the square keeps the
 * scale. It reproduces the frame's own centring, so the square sits where it
 * always did.
 */
import type { ComponentProps } from "astro/types";
import SanityImg from "@/components/Media/SanityImg.astro";

type Props = {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** A case, as projected by `CASES_LIST_QUERY` and friends. */
  case: {
    title?: string | null;
    slug?: string | null;
    thumbnail?: ComponentProps<typeof SanityImg>["image"];
    service?: { title?: string | null } | null;
  };
  /**
   * Where the list sits. The homepage grid fades each card in on scroll;
   * the subpage grids animate the link instead, as the export did.
   */
  variant?: "home" | "subpage";
};

const { render = true, case: c, variant = "subpage" } = Astro.props;
---

{
  render && c.slug && (
    <div
      role="listitem"
      class:list={["case", "w-dyn-item", variant === "home" ? "fade-in-bottom" : "case-subpage"]}
    >
      <a
        href={`/case/${c.slug}`}
        class:list={["case-wrapper", "w-inline-block", variant === "subpage" && "fade-in-bottom"]}
      >
        <div class="project-thumbnail-wrapper">
          <SanityImg
            image={c.thumbnail}
            class="project-thumbnail"
            sizes="(min-width: 62rem) 40vw, 100vw"
          />
          <canvas class="project-pixels" aria-hidden="true"></canvas>
          <div class="case-overlay"></div>
          <div class="view-square-track">
            <div class="view-square"><div>View</div></div>
          </div>
        </div>
        <div class="case-info-wrapper">
          <div class="case-info-container">
            <h3 class="text-3xl margin-bottom-4">{c.title}</h3>
            {c.service?.title && <p class="case-service">{c.service.title}</p>}
          </div>
        </div>
      </a>
    </div>
  )
}

<style is:global>
  @layer components {
    /* The three easings `a-58`/`a-59` name, as their bezier equivalents. */
    .case {
      --case-out-sine: cubic-bezier(0.39, 0.575, 0.565, 1);
      --case-in-out-quad: cubic-bezier(0.455, 0.03, 0.515, 0.955);
      --case-in-out-quart: cubic-bezier(0.77, 0, 0.175, 1);
    }

    /* The service name is a Departure label. Set here rather than in the
       `webflow` layer, where the brand `p` rule outranks it. */
    .case-service {
      /* `--system`, not `--signal-green` directly: green on a dark ground,
         `--ink` on a light one, where green text is not legal. */
      color: var(--system);
      font-family: var(--label-font-family);
      font-weight: var(--label-font-weight);
      font-size: var(--label-md);
      line-height: var(--label-md-line-height);
      letter-spacing: var(--label-letter-spacing);
      text-transform: var(--label-text-transform);
    }

    /* Base state is the hover-out half of the pair: `a-59` returns both
       properties over 550ms. `a-58` brings them in on separate clocks, so
       those durations live on the hover rule instead. */
    /* The pixelated copy of the thumbnail. The script lays it over the
       image's own box, so it takes the same scale and dim as the image. */
    .case .project-pixels {
      position: absolute;
      pointer-events: none;
      visibility: hidden;
      image-rendering: pixelated;
    }

    .case .project-pixels[data-active] {
      visibility: visible;
    }

    .case .project-thumbnail,
    .case .project-pixels {
      transform-origin: center;
      transition:
        opacity 550ms var(--case-out-sine),
        transform 550ms var(--case-out-sine);
    }

    .case .case-info-wrapper {
      transition: transform 250ms var(--case-out-sine);
    }

    .case .view-square-track {
      display: flex;
      justify-content: center;
      align-items: center;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .case .view-square {
      opacity: 0;
      transform: scale(0.6);
      transition:
        opacity 150ms var(--case-out-sine),
        transform 150ms var(--case-out-sine);
    }

    @media (hover: hover) {
      .case-wrapper:hover .project-thumbnail,
      .case-wrapper:hover .project-pixels {
        opacity: 0.8;
        transform: scale(1.05);
        transition:
          opacity 250ms var(--case-in-out-quad),
          transform 500ms var(--case-out-sine);
      }

      .case-wrapper:hover .case-info-wrapper {
        transform: translateY(-0.5rem);
      }

      .case-wrapper:hover .view-square-track {
        will-change: transform;
      }

      .case-wrapper:hover .view-square {
        opacity: 1;
        transform: scale(1);
        transition:
          opacity 50ms var(--case-in-out-quart),
          transform 150ms var(--case-out-sine);
      }
    }

    /* Show the square, but move nothing: the scale and the rise are the
       parts worth dropping, and the frame loop never starts. */
    @media (prefers-reduced-motion: reduce) {
      .case .project-thumbnail,
      .case .project-pixels,
      .case .case-info-wrapper,
      .case .view-square,
      .case-wrapper:hover .project-thumbnail,
      .case-wrapper:hover .project-pixels,
      .case-wrapper:hover .case-info-wrapper,
      .case-wrapper:hover .view-square {
        transform: none;
        transition: none;
      }
    }
  }
</style>

<script>
  /* IX2's `a-54`: ±60px of travel on each axis, `smoothing: 95` (a 0.05 lerp
     per frame) and `restingState: 50` (centre). Bundled once for the page
     however many cards are on it. */
  const FRAME = ".project-thumbnail-wrapper";
  const TRACK = ".view-square-track";
  const REACH = 60;
  const SMOOTHING = 0.05;
  const FRAME_MS = 1000 / 60;

  const clamp01 = (n: number) => Math.min(Math.max(n, 0), 1);

  const follow = (frame: HTMLElement) => {
    const track = frame.querySelector<HTMLElement>(TRACK);
    if (!track) return;

    let pointerX = 0;
    let pointerY = 0;
    let x = 0;
    let y = 0;
    let hovering = false;
    let raf = 0;
    let last = 0;

    const tick = (now: number) => {
      /* Elapsed frames, so a 120Hz display converges at the same rate a 60Hz
         one does. Capped so a backgrounded tab does not jump on return. */
      const step = last ? Math.min((now - last) / FRAME_MS, 4) : 1;
      last = now;

      let targetX = 0;
      let targetY = 0;

      if (hovering) {
        /* Read once a frame, immediately before the write below — the frame
           can scroll under a held pointer. */
        const rect = frame.getBoundingClientRect();
        if (rect.width) targetX = (clamp01((pointerX - rect.left) / rect.width) - 0.5) * 2 * REACH;
        if (rect.height) targetY = (clamp01((pointerY - rect.top) / rect.height) - 0.5) * 2 * REACH;
      }

      const k = 1 - Math.pow(1 - SMOOTHING, step);
      x += (targetX - x) * k;
      y += (targetY - y) * k;

      if (!hovering && Math.abs(x) < 0.1 && Math.abs(y) < 0.1) {
        track.style.transform = "";
        x = 0;
        y = 0;
        raf = 0;
        last = 0;
        return;
      }

      track.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
      raf = requestAnimationFrame(tick);
    };

    const run = () => {
      if (raf) return;
      last = 0;
      raf = requestAnimationFrame(tick);
    };

    frame.addEventListener("pointermove", (event) => {
      if (event.pointerType === "touch") return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      hovering = true;
      run();
    });

    frame.addEventListener("pointerleave", () => {
      hovering = false;
      run();
    });
  };

  /* Pixelate on hover: the thumbnail is redrawn onto a canvas at a fraction
     of its size and scaled back up without smoothing. The block size steps
     up through BLOCKS on the way in and back down on the way out — stepped,
     not eased, so it reads as a pixel grid snapping rather than a blur.
     Under reduced motion it jumps straight to the last step and back. */
  const BLOCKS = [2, 3, 4, 6, 8, 10, 12, 14, 17, 20];
  const STEP_MS = 60;

  const pixelate = (frame: HTMLElement, reduced: boolean) => {
    const img = frame.querySelector<HTMLImageElement>(".project-thumbnail");
    const canvas = frame.querySelector<HTMLCanvasElement>(".project-pixels");
    const ctx = canvas?.getContext("2d");
    if (!img || !canvas || !ctx) return;

    const small = document.createElement("canvas");
    const sctx = small.getContext("2d");
    if (!sctx) return;

    let level = 0; // 0 = sharp, BLOCKS.length = fully pixelated
    let target = 0;
    let timer = 0;

    const draw = () => {
      if (!level) {
        canvas.removeAttribute("data-active");
        return;
      }
      /* Layout box, not the client rect: the image may already be scaled. */
      const w = img.offsetWidth;
      const h = img.offsetHeight;
      if (!w || !h || !img.complete || !img.naturalWidth) return;

      const dpr = window.devicePixelRatio || 1;
      Object.assign(canvas.style, {
        left: `${img.offsetLeft}px`,
        top: `${img.offsetTop}px`,
        width: `${w}px`,
        height: `${h}px`,
      });
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);

      const block = BLOCKS[level - 1];
      small.width = Math.max(1, Math.ceil(w / block));
      small.height = Math.max(1, Math.ceil(h / block));
      sctx.imageSmoothingEnabled = true;
      sctx.drawImage(img, 0, 0, small.width, small.height);

      ctx.imageSmoothingEnabled = false;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(
        small,
        0,
        0,
        small.width,
        small.height,
        0,
        0,
        small.width * block * dpr,
        small.height * block * dpr,
      );
      canvas.setAttribute("data-active", "");
    };

    const step = () => {
      timer = 0;
      if (level === target) return;
      level += level < target ? 1 : -1;
      draw();
      if (level !== target) timer = window.setTimeout(step, STEP_MS);
    };

    const go = (to: number) => {
      target = to;
      if (reduced) {
        window.clearTimeout(timer);
        timer = 0;
        level = to;
        draw();
      } else if (!timer) {
        step();
      }
    };

    frame.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "touch") return;
      go(BLOCKS.length);
    });
    frame.addEventListener("pointerleave", () => go(0));
  };

  const start = () => {
    if (!window.matchMedia("(hover: hover)").matches) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>(FRAME).forEach((frame) => {
      pixelate(frame, reduced);
      if (!reduced) follow(frame);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
</script>
