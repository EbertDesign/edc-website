---
/**
 * The site's entrance animations, rebuilt off Webflow's IX2.
 *
 * IX2 was the one piece of the export that could not be moved as it stood: it
 * is compiled into `webflow.js` against `data-w-id` attributes, so it had to
 * be re-authored rather than relocated. What it did here is simple and worth
 * keeping — blocks fade up as they scroll into view, and the hero does the
 * same on load — so it is an IntersectionObserver and two CSS classes instead
 * of 247 KB of `webflow.js` plus jQuery.
 *
 * The class names are the export's own (`.fade-in-bottom`,
 * `.fade-in-bottom-100ms`) so no markup had to change to keep them working.
 * `.fade-in-load` is new, and stands in for the hero's load timeline.
 *
 * Two things the original got wrong and this does not:
 *
 * - **It degrades.** IX2 hid every animated element in CSS and relied on
 *   JavaScript to show it again, so a failed script left the page blank. Here
 *   the hidden state only applies once the script has set `data-reveal` on
 *   the root, so with no JavaScript everything is simply visible.
 * - **It honours `prefers-reduced-motion`.** IX2 animated through jQuery and
 *   ignored the setting entirely.
 *
 * Rendered once, by `BaseLayout`.
 */
---

<style is:global>
  @layer components {
    /* Only hides once the script has announced itself — see above. */
    [data-reveal]
      :is(
        .fade-in-bottom,
        .fade-in-bottom-100ms,
        .fade-in-load,
        .fade-in-load-far
      ) {
      opacity: 0;
      transform: translateY(var(--_reveal-distance, 2.5rem));
      transition:
        opacity var(--_reveal-duration, 700ms) var(--_reveal-ease, ease-out)
          var(--_reveal-delay, 0ms),
        transform var(--_reveal-duration, 700ms) var(--_reveal-ease, ease-out)
          var(--_reveal-delay, 0ms);
      will-change: opacity, transform;
    }

    [data-reveal] .fade-in-bottom-100ms {
      --_reveal-delay: 100ms;
    }

    /* Everything in the hero's load timeline travelled 40px except the
       headline, which travelled 104px. */
    [data-reveal] .fade-in-load-far {
      --_reveal-distance: 6.5rem;
    }

    /* The original staggered the three columns; keep that. */
    [data-reveal] .fade-in-load-2 {
      --_reveal-delay: 100ms;
    }

    [data-reveal] .fade-in-load-3 {
      --_reveal-delay: 200ms;
    }

    [data-reveal]
      :is(
        .fade-in-bottom,
        .fade-in-bottom-100ms,
        .fade-in-load,
        .fade-in-load-far
      ).is-revealed {
      opacity: 1;
      transform: none;
      will-change: auto;
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal]
        :is(
          .fade-in-bottom,
          .fade-in-bottom-100ms,
          .fade-in-load,
          .fade-in-load-far
        ) {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  }
</style>

<script>
  const SELECTOR =
    ".fade-in-bottom, .fade-in-bottom-100ms, .fade-in-load, .fade-in-load-far";
  /* Anything in the hero's load timeline, played at once rather than on scroll. */
  const ON_LOAD = ".fade-in-load, .fade-in-load-far";

  /* Claim the hidden state only now that we can undo it. Anything the
     observer never reaches stays visible rather than disappearing. */
  document.documentElement.setAttribute("data-reveal", "");

  const reveal = (el: Element) => el.classList.add("is-revealed");

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  const start = () => {
    const targets = document.querySelectorAll(SELECTOR);

    if (reduced.matches || !("IntersectionObserver" in window)) {
      targets.forEach(reveal);
      return;
    }

    /* The hero is already on screen; play it immediately rather than waiting
       for a scroll that may never come. */
    document.querySelectorAll(ON_LOAD).forEach(reveal);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          reveal(entry.target);
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0 },
    );

    targets.forEach((el) => {
      if (!el.matches(ON_LOAD)) observer.observe(el);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
</script>
