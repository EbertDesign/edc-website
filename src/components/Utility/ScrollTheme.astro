---
/**
 * Recolours the whole page as it scrolls, the way the Webflow demo this was
 * modelled on does: the colour tokens themselves change, so backgrounds,
 * headings, body copy and accents all move together and no section is left
 * sitting at its old colour against a new one.
 *
 * Mark the element that should bring a colour in with `data-scroll-theme-to`,
 * and the page takes that theme once the element passes a line across the
 * screen — its top against a line 80% of the way down by default, so the
 * change happens as the block arrives rather than long before it.
 * `data-scroll-theme-offset` moves that line per element, `0` being the top of
 * the window, and `data-scroll-theme-edge="bottom"` watches the element's
 * bottom edge rather than its top — the two together are how "once this has
 * scrolled out of view" is spelt. The last marker the scroll has passed wins,
 * so going back up puts the earlier colour back.
 *
 * The tokens are `@property`-registered as colours, which is what lets them
 * be transitioned at all: CSS can only interpolate a custom property whose
 * type it knows. Everything reading them through `var()` — including the
 * export's own swatches, which paint the page background, the links and the
 * hover states — then fades without needing a transition of its own.
 *
 * With no JavaScript the page keeps the theme it was authored in.
 */
---

<style is:global>
  /* The 2026 tokens. A custom property can only be transitioned once CSS
     knows its type, so each is registered as a colour. The initial values are
     Field's, since Field is the default mode — they are only the fallback for
     an invalid value, not the authored theme.

     The export's own swatches stay registered below them: the `webflow`
     layer still paints what has not been migrated and reads `--black`,
     `--white`, `--accent` and the two greys directly. They go when it does.
     The framework's old `--background` / `--text` pair is gone already. */
  @property --ground {
    syntax: "<color>";
    inherits: true;
    initial-value: #f8f7f3;
  }
  @property --ground-raised {
    syntax: "<color>";
    inherits: true;
    initial-value: #efeee8;
  }
  @property --ink {
    syntax: "<color>";
    inherits: true;
    initial-value: #161616;
  }
  @property --ink-muted {
    syntax: "<color>";
    inherits: true;
    initial-value: #5e625f;
  }
  @property --rule {
    syntax: "<color>";
    inherits: true;
    initial-value: #d6d8d2;
  }
  @property --system {
    syntax: "<color>";
    inherits: true;
    initial-value: #161616;
  }
  @property --accent-fill {
    syntax: "<color>";
    inherits: true;
    initial-value: #ff5500;
  }
  @property --emphasis-fill {
    syntax: "<color>";
    inherits: true;
    initial-value: #bfdd9e;
  }

  @property --accent {
    syntax: "<color>";
    inherits: true;
    initial-value: #161616;
  }
  @property --light-grey {
    syntax: "<color>";
    inherits: true;
    initial-value: #ffffff99;
  }
  @property --dark-grey {
    syntax: "<color>";
    inherits: true;
    initial-value: #333333;
  }
  @property --black {
    syntax: "<color>";
    inherits: true;
    initial-value: #0e0e0f;
  }
  @property --white {
    syntax: "<color>";
    inherits: true;
    initial-value: #ffffff;
  }

  @layer components {
    :root {
      --_scroll-theme-transition: 800ms ease;

      transition:
        --ground var(--_scroll-theme-transition),
        --ground-raised var(--_scroll-theme-transition),
        --ink var(--_scroll-theme-transition),
        --ink-muted var(--_scroll-theme-transition),
        --rule var(--_scroll-theme-transition),
        --system var(--_scroll-theme-transition),
        --accent-fill var(--_scroll-theme-transition),
        --emphasis-fill var(--_scroll-theme-transition),
        --accent var(--_scroll-theme-transition),
        --light-grey var(--_scroll-theme-transition),
        --dark-grey var(--_scroll-theme-transition),
        --black var(--_scroll-theme-transition),
        --white var(--_scroll-theme-transition);
    }

    /* No per-theme tokens here. A scroll theme is a mode name — the homepage
       scrolls to `field` — and `brand.css` lists `:root[data-scroll-theme=…]`
       beside that mode, so its tokens and the export's aliases are defined in
       one place. (The old `brand` value was a signal-green ground, retired
       2026-11-18: green never appears as a ground on paper.) */

    /* The eyebrow marker needs no transition of its own: it reads
       `--accent-fill`, which is registered above and fades on the root with
       everything else. A second `background-color` transition on the marker
       stacked on top of that one and left it trailing the page by a beat. */

    @media (prefers-reduced-motion: reduce) {
      :root {
        transition: none;
      }
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLElement>(
    "[data-scroll-theme-to]",
  );

  if (triggers.length) {
    const root = document.documentElement;
    const DEFAULT_OFFSET = 80;
    let frame = 0;

    /* The theme of the last marker whose top has crossed its line. Read from
       position rather than remembered from events, so it is right after a
       resize, a reload part-way down, or a jump to an anchor. */
    const update = () => {
      frame = 0;

      let theme = "";

      for (const trigger of triggers) {
        const offset = Number(trigger.dataset.scrollThemeOffset);
        const line =
          (window.innerHeight *
            (Number.isFinite(offset) ? offset : DEFAULT_OFFSET)) /
          100;

        const rect = trigger.getBoundingClientRect();
        const edge =
          trigger.dataset.scrollThemeEdge === "bottom" ? rect.bottom : rect.top;

        if (edge <= line) {
          theme = trigger.dataset.scrollThemeTo ?? "";
        }
      }

      if (theme) {
        root.setAttribute("data-scroll-theme", theme);
      } else {
        root.removeAttribute("data-scroll-theme");
      }
    };

    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }
</script>
