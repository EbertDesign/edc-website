---
/**
 * The hero at the top of every subpage — a case study, a service, a
 * deliverable, and About. A backdrop image pinned to the right two-thirds
 * with a hard vertical edge, and the page title over it.
 *
 * The same block as `SectionHeroHome` in spirit, but a different one in fact:
 * that one is 100vh with a row of audience columns beneath, this is 68vh with
 * only a title. Both keep the export's own values rather than the token scale
 * — including the 69.3% panel, which is the design and not a leftover.
 *
 * Four routes were repeating this markup and quietly borrowing
 * `SectionHeroHome`'s stylesheet for it, which meant editing the homepage
 * hero could silently reshape four other pages. It owns its styles now.
 *
 * With `intro`, the backdrop plays the homepage's load timeline — opening
 * full-screen and collapsing into the panel. That is `Utility/HeroIntro`,
 * shared with `SectionHeroHome`; the elements below wear its role classes.
 */
import type { ComponentProps } from "astro/types";
import SanityImg from "@/components/Media/SanityImg.astro";
import HeroIntro from "@/components/Utility/HeroIntro.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The backdrop, from Sanity. Leave unset and pass `imageSrc` for a static one. */
  image?: ComponentProps<typeof SanityImg>["image"];
  /** A static backdrop in `public/`, for pages with no CMS image. */
  imageSrc?: string;
  /** `srcset` for a static backdrop. */
  imageSrcset?: string;
  /** Play the load intro: the backdrop opens full-screen, then collapses in. */
  intro?: boolean;
};

const {
  render = true,
  image,
  imageSrc,
  imageSrcset,
  intro = false,
} = Astro.props;
const content = await slotContent(Astro.slots);

/* The width of the title's longest word, in em, so only a title that needs
   to shrink does. An estimate from Aktiv Grotesk Extended's proportions; the
   1.04 covers the widest real title, which ran 3.4% over. The last `h1` is
   the title, since About's eyebrow is an `h1` too. */
const titleHtml = [...content.matchAll(/<h1\b[^>]*>([\s\S]*?)<\/h1>/g)].at(-1)?.[1] ?? "";
const titleWord = 1.04 * Math.max(
  1,
  ...titleHtml
    .replace(/<[^>]+>/g, "")
    .replace(/&[#\w]+;/g, "x")
    .split(/[\s-]+/)
    .map((word) =>
      [...word].reduce(
        (width, char) =>
          width + (/[mwMW]/.test(char) ? 1 : /[iljtfrI.,'’]/.test(char) ? 0.4 : 0.7),
        0,
      ),
    ),
);
---

{
  render && content && (
    <>
      {intro && <HeroIntro />}
      <section class:list={["hero-subpage_wrap", intro && "intro"]}>
        <div class:list={["hero-subpage_inner", intro && "hero-intro_panel"]}>
          <div
            class:list={["hero-subpage_backdrop", intro && "hero-intro_crop"]}
          >
            {image && (
              <SanityImg
                image={image}
                alt=""
                loading="eager"
                class="hero-subpage_image"
                sizes="(min-width: 62rem) 70vw, 100vw"
              />
            )}
            {!image && imageSrc && (
              <img
                class="hero-subpage_image"
                src={imageSrc}
                srcset={imageSrcset}
                sizes="(min-width: 62rem) 70vw, 100vw"
                loading="eager"
                alt=""
              />
            )}
          </div>
          <div class="_12-column-grid">
            <div
              class:list={[
                "hero-subpage_content hero-cell-title",
                intro ? "hero-intro_lead" : "fade-in-bottom",
              ]}
              style={`--_title-word: ${titleWord.toFixed(2)}`}
            >
              <Fragment set:html={content} />
            </div>
          </div>
        </div>
      </section>
    </>
  )
}

<style is:global>
  @layer components {
    /* The export's `.section` base: no padding, and the gap below carried as
       a margin so a following block's margin collapses into it. */
    .hero-subpage_wrap {
      min-height: 2rem;
      margin-bottom: 12.5rem;
      padding: 0;
    }

    /* The intro takes the inner to 100vh and back. Fixing the height here
       lets it overflow for those three seconds, the way the homepage hero's
       own 100vh section does, rather than pushing the page down and hauling
       it back up. Below the breakpoint the intro does not play. */
    @media (width >= 62rem) {
      .hero-subpage_wrap.intro {
        height: 68vh;
      }
    }

    /* `.container.hero-top-container` — 68vh, with the title on the bottom. */
    .hero-subpage_inner {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      width: 100%;
      height: 68vh;
      padding-inline: 9.5vw;
    }

    /* The intentional hard edge: a 69.3%-wide panel pinned right, behind the
       page. It paints because the root is transparent and the body carries
       the canvas — see the note in base.css. */
    .hero-subpage_backdrop {
      position: absolute;
      inset: 0 0 auto auto;
      z-index: -10;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 69.3%;
      height: 100%;
      overflow: hidden;
    }

    .hero-subpage_image {
      z-index: -1;
      height: 100%;
      object-fit: cover;
      opacity: 0.8;
    }

    /* The grid is the container, not the title's own cell: a cell that is a
       size container has no content width to resolve against and collapses
       to zero. The backdrop sits outside it, so its stacking is untouched. */
    .hero-subpage_inner > ._12-column-grid {
      container-type: inline-size;
      width: 100%;
    }

    .hero-subpage_content {
      --_title-size: 7rem;
      /* From the title's start line to the grid's right edge: 11 of 12. */
      --_title-fit: calc(91.2cqi / var(--_title-word));
      min-width: 0;
    }

    /* The export's sizes, capped only where this title's own longest word
       would not otherwise fit. Child combinator: on About
       the `h1` is the eyebrow's, nested a level down. */
    .hero-subpage_content > h1 {
      font-size: min(var(--_title-size), var(--_title-fit));
    }

    @media (width < 62rem) {
      .hero-subpage_wrap {
        margin-bottom: 7.5rem;
      }

      .hero-subpage_inner {
        height: auto;
        margin-bottom: 5rem;
        padding-inline: 0;
      }

      .hero-subpage_backdrop {
        position: relative;
        width: 100%;
      }

      /* The inner drops its padding here, so the title carries the page
         gutter itself and lines up with the content below. */
      .hero-subpage_content {
        --_title-size: 6.5rem;
        --_title-gutter: 3rem;
        --_title-fit: calc((100cqi - 2 * var(--_title-gutter)) / var(--_title-word));
        padding-block-start: var(--space-6);
        padding-inline: var(--_title-gutter);
      }
    }

    @media (width < 48rem) {
      .hero-subpage_content {
        --_title-size: 2.9rem;
        --_title-gutter: 2.5rem;
      }
    }

    @media (width < 30rem) {
      .hero-subpage_wrap {
        margin-bottom: 5rem;
      }

      .hero-subpage_content {
        --_title-gutter: 1.5rem;
      }
    }
  }
</style>
