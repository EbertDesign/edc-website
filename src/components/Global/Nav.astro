---
/**
 * PASS 1 — the Webflow export's nav markup, brought across verbatim so the
 * page can be proved identical to https://ebertdesign.co before anything is
 * changed. It is still a `w-nav` widget: the mobile menu is driven by
 * webflow.js + jQuery, and both leave in pass 2 when this becomes the Lumos
 * nav (disclosure button, no jQuery, `aria-current` from the route).
 */
type Props = {
  /** Kept for BaseLayout's API; the export pins the bar with `position-absolute`. */
  overlap?: boolean;
};
const _ = Astro.props satisfies Props;
---

<div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar wf-position-absolute w-nav">
    <div class="nav-container">
      <a href="/" aria-current="page" class="nav-logo w-nav-brand w--current"><img src="/images/edc-logo-light-.svg" loading="lazy" width="Auto" alt="" class="logo" /></a>
      <nav role="navigation" class="nav-menu w-nav-menu">
        <a href="/work" class="nav-link first-navlink w-nav-link">Work</a>
        <a href="/about" class="nav-link w-nav-link">About</a>
        <a href="/journal" class="nav-link w-nav-link">Journal</a>
        <a href="/contact" class="nav-link w-nav-link">Contact</a>
      </nav>
      <div class="menu-button w-nav-button">
        <div class="top-line"></div>
        <div class="bottom-line"></div>
      </div>
    </div>
  </div>
