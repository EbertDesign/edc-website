---
/**
 * The site nav. Structure and behaviour are the framework's — a real
 * disclosure button, `aria-expanded`, Escape and outside-click to close, and
 * `aria-current` derived from the route by `NavLink`. The design is the
 * imported one: a transparent bar laid over the hero, Syne links that go to
 * the brand colour, and a two-line hamburger below the large breakpoint.
 *
 * Replaces Webflow's `w-nav` widget, so nothing here needs jQuery or
 * `webflow.js`. The export's `.navbar`, `.nav-container`, `.nav-menu`,
 * `.nav-link`, `.nav-logo`, `.menu-button`, `.top-line`, `.bottom-line` and
 * `.logo` rules have moved into this file and are gone from `site.css`.
 */
import Icon from "@/components/Media/Icon.astro";
import NavLink from "@/components/Global/NavLink.astro";
import logo from "@/assets/logo/edc-logo.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * Lay the nav over the page rather than letting it sit in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              <NavLink href="/work">Work</NavLink>
              <NavLink href="/about">About</NavLink>
              <NavLink href="/journal">Journal</NavLink>
              <NavLink href="/contact">Contact</NavLink>
            </ul>
          </div>
        </nav>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    /* The bar collapses at the site's large breakpoint, not the framework's
       default — see the matching query in the styles below. */
    window
      .matchMedia("(width >= 62rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      /* The imported bar is transparent and sits over the hero. Below the
         large breakpoint it returns to the flow on a solid panel, which is
         what the export's `@media (max-width: 991px)` rules did. */
      --_inline-padding: 1.5rem;

      position: relative;
      z-index: 10;
      display: flex;
      justify-content: center;
      width: 100%;
      background-color: var(--background);
      color: var(--text);
    }

    .nav_inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
      width: 100%;
      /* 24px block padding around a 48px control gives the export's 96px bar. */
      padding: 1.5rem var(--_inline-padding);
    }

    .nav_logo {
      /* The export sets `.logo { width: 50% }` on an image inside a
         shrink-to-fit float, which resolves to zero — so the live site shows
         no logo at all below 480px. Kept visible here on purpose, sized to
         sit inside the 48px control row; the bar's height is unchanged. */
      z-index: 99;
      display: flex;
      align-items: center;
      width: 100%;
      max-width: 8rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      /* Two 32×2 bars, 8px apart — the export's `.top-line` / `.bottom-line`. */
      --_icon-width: 2rem;
      --_bar-gap: 0.5rem;

      z-index: 99;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 3rem;
      min-height: 3rem;
      margin-right: calc((3rem - var(--_icon-width)) / -2);
      color: inherit;
      background-color: transparent;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + 0.125rem);
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: 0.125rem; /* the export's 2px */
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 0;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: 100svh;
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      /* The open panel clears the bar the way the export's 120px top
         padding did. */
      display: flex;
      flex-direction: column;
      padding: 7.5rem var(--_inline-padding) var(--space-8);
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--text);
      font-family: var(--display-family);
      font-size: 1.125rem;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--brand-500);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
        }
      }
    }

    /* 30rem — the export tightened the gutters twice on the way down. */
    @media (width >= 30rem) {
      .nav_wrap {
        --_inline-padding: 2.5rem;
      }
    }

    @media (width >= 48rem) {
      .nav_wrap {
        --_inline-padding: 3rem;
      }
    }

    /* 62rem is where this site's nav stops collapsing — Webflow's
       `data-collapse="medium"` breakpoint, not the framework's 48rem. */
    @media (width >= 62rem) {
      .nav_wrap {
        --_inline-padding: 9.5vw;

        margin-top: 1.5rem;
        background-color: transparent;
      }

      /* Only the pages with artwork behind the bar lay it over the page —
         5 of the export's 11, which carried `.navbar.position-absolute`.
         The rest keep it in flow above the first section. */
      .nav_wrap.overlap {
        position: absolute;
        inset-inline: 0;
      }

      .nav_inner {
        padding-block: 0;
      }

      .nav_logo {
        max-width: 11.25rem; /* the export's 180px */
      }

      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        max-height: none;
        overflow: visible;
        background-color: transparent;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
      }

      .nav_link {
        padding: var(--space-6) var(--space-4);
      }

      /* The export zeroes the outer padding so the row ends flush. */
      .nav_links > li:first-child .nav_link {
        padding-left: 0;
      }

      .nav_links > li:last-child .nav_link {
        padding-right: 0;
      }
    }
  }
</style>
