---
/**
 * The site footer. The export's `.footer`, `.footer-content-container`,
 * `.footer-text`, `.footer-nav-links-container`, `.footer-navlink`,
 * `.footer-nav-badges-container`, `.footer-badge-*`, `.footer-links-container`,
 * `.footer-link-list*` and `.subfooter-*` rules have moved into this file and
 * are gone from `site.css`.
 *
 * Two things came out in the move. The badge images were Webflow `-p-NNN`
 * srcsets rendered at 120px wide; they are `Media/Img` now, so Astro sizes
 * them. And the copyright was a link to the homepage with `aria-current` on
 * it — a second "you are here" pointing at the page you are already on — so
 * it is plain text, with the year computed rather than hard-coded.
 *
 * The template also shipped a second, unused footer (`.footer_container`,
 * `.footer__moving-text*` — an accent marquee). No page referenced it and it
 * has been dropped rather than carried across.
 */
import Img from "@/components/Media/Img.astro";
import Icon from "@/components/Media/Icon.astro";
import mark from "@/assets/logo/edc-mark.svg";
import { SITE_NAME } from "@/consts.ts";

import cleanCreatives from "@/assets/badges/clean-creatives.png";
import makerDivision from "@/assets/badges/maker-division.png";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

const pages = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/journal", label: "Journal" },
  { href: "/contact", label: "Contact" },
];

const badges = [
  {
    href: "https://cleancreatives.org/",
    src: cleanCreatives,
    alt: "Clean Creatives pledge",
  },
  {
    href: "https://www.makerdivision.com/",
    src: makerDivision,
    alt: "Maker Division affiliate",
  },
];

const social = [
  { href: "https://www.instagram.com/ebertdesign/", label: "Instagram" },
  { href: "https://www.behance.net/jessicaebe8769", label: "Behance" },
  {
    href: "https://www.linkedin.com/in/zachary-ebert-422686a0/",
    label: "Linkedin",
  },
];
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_divider" />

        <p class="footer_intro">
          We are a fluid branding agency working with purpose-driven brands and
          nonprofits all over the world.
        </p>

        <nav class="footer_nav" aria-label="Footer">
          <ul class="footer_links">
            {pages.map(({ href, label }) => (
              <li>
                <a class="footer_link" href={href}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <ul class="footer_badges">
          {badges.map(({ href, src, alt }) => (
            <li>
              <a
                class="footer_badge"
                href={href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Img
                  src={src}
                  alt={alt}
                  variant="densities"
                  width={120}
                  transparent
                />
              </a>
            </li>
          ))}
        </ul>

        <div class="footer_meta">
          <div class="footer_social_group">
            <Icon src={mark} class="footer_mark" />
            <ul class="footer_social">
            {social.map(({ href, label }) => (
              <li>
                <a
                  class="footer_meta_link"
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label}
                </a>
              </li>
              ))}
            </ul>
          </div>
          <p class="footer_meta_link footer_copyright">
            &copy; {new Date().getFullYear()} {SITE_NAME}
          </p>
        </div>
      </div>
    </footer>
  )
}

<style is:global>
  @layer components {
    .footer_wrap {
      --_inline-padding: 1.5rem;

      width: 100%;
      padding-bottom: 3rem;
      background-color: var(--background);
      color: var(--text);
    }

    .footer_inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      padding-inline: var(--_inline-padding);
    }

    /* The export's `.divider` — a hairline in the mid grey. */
    .footer_divider {
      width: 100%;
      height: 0.0625rem;
      background-color: var(--dark-700);
    }

    .footer_intro {
      /* 70% / 50% / 35% up the breakpoints — the export set these on
         `.light-grey-text.footer-text`, which outranked its own
         `.footer-text { max-width: 40% }`, so 40% never applied. */
      max-width: 70%;
      margin-top: 7.5rem;
      color: var(--text-2);
    }

    .footer_nav {
      width: 100%;
      margin-top: 4rem;
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .footer_link {
      font-family: var(--display-family);
      font-size: 2.5rem;
      font-weight: var(--primary-medium);
      color: var(--text);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--brand-500);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
        }
      }
    }

    .footer_badges {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      /* 40px below the links plus 10px above the badges in the export, and
         the column is flex so those did not collapse. */
      margin-top: 3.125rem;
      margin-bottom: 7.5rem;
    }

    .footer_badge {
      display: block;
      width: 7.5rem; /* the export's 120px */
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_meta {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      width: 100%;
    }

    /* The small EDC mark that sat before the social links. The export shipped
       it as a 27px image with a baked-in #e8e0d9; it follows the theme now. */
    .footer_mark {
      --_size: 1.6875rem;
      margin-bottom: 2.5rem;
      color: var(--text-2);
    }

    .footer_social_group {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .footer_social {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .footer_meta_link {
      color: var(--text-2);
      line-height: var(--line-height-huge);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
    }

    a.footer_meta_link {
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_copyright {
      margin-top: 3rem;
    }

    @media (width >= 30rem) {
      .footer_wrap {
        --_inline-padding: 2.5rem;
      }

      .footer_social {
        flex-direction: row;
        align-items: center;
        gap: 2.5rem;
      }

      .footer_social_group {
        flex-direction: row;
        align-items: center;
      }

      .footer_mark {
        margin-bottom: 0;
        margin-right: 2.5rem;
      }
    }

    @media (width >= 48rem) {
      .footer_wrap {
        --_inline-padding: 3rem;
      }

      .footer_intro {
        max-width: 50%;
      }

      .footer_links {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0 2rem;
      }

      .footer_badges {
        flex-direction: row;
        gap: 3rem;
        margin-bottom: 6.25rem;
      }

      .footer_meta {
        flex-direction: row;
      }

      .footer_copyright {
        margin-top: 0;
      }
    }

    @media (width >= 62rem) {
      .footer_wrap {
        --_inline-padding: 9.5vw;

        padding-bottom: 5rem;
      }

      .footer_intro {
        max-width: 35%;
      }

      .footer_links {
        gap: 0 3rem;
      }

      .footer_link {
        font-size: 3rem;
      }
    }
  }
</style>
