---
/**
 * PASS 1 — the export's footer markup, verbatim. Becomes Lumos components in
 * pass 2; the badge images still carry Webflow's `-p-NNN` srcsets and become
 * `Media/Img` then.
 */
---

<div class="footer">
    <div class="wf-container">
      <div class="divider"></div>
      <div class="footer-content-container">
        <p class="light-grey-text footer-text">We are a fluid branding agency working with purpose-driven brands and nonprofits all over the world.</p>
        <div class="footer-nav-links-container">
          <a href="/work" class="footer-navlink">Work</a>
          <a href="/about" class="footer-navlink">About</a>
          <a href="/journal" class="footer-navlink">Journal</a>
          <a href="/contact" class="footer-navlink">Contact</a>
        </div>
        <div class="footer-nav-badges-container">
          <a href="https://cleancreatives.org/" target="_blank" class="footer-badge-link w-inline-block"><img src="/images/Clean-Creatives-SealTRANSPARENT-OFF-WHITE1080.png" loading="lazy" sizes="100vw" srcset="/images/Clean-Creatives-SealTRANSPARENT-OFF-WHITE1080-p-500.png 500w, /images/Clean-Creatives-SealTRANSPARENT-OFF-WHITE1080.png 1080w" alt="" class="footer-badge-image" /></a>
          <a href="https://www.makerdivision.com/" target="_blank" class="footer-badge-link w-inline-block"><img src="/images/Maker_Division_Affiliate_Badge_Dark_Mode.png" loading="lazy" sizes="100vw" srcset="/images/Maker_Division_Affiliate_Badge_Dark_Mode-p-500.png 500w, /images/Maker_Division_Affiliate_Badge_Dark_Mode-p-800.png 800w, /images/Maker_Division_Affiliate_Badge_Dark_Mode-p-1080.png 1080w, /images/Maker_Division_Affiliate_Badge_Dark_Mode.png 1114w" alt="" class="footer-badge-image" /></a>
        </div>
        <div class="footer-links-container">
          <div class="footer-link-list"><img src="/images/Asset-11-.svg" loading="lazy" width="27" height="27" alt="" class="subfooter-logo" />
            <a href="https://www.instagram.com/ebertdesign/" target="_blank" class="subfooter-link">Instagram</a>
            <a href="https://www.behance.net/jessicaebe8769" class="subfooter-link">Behance</a>
            <a href="https://www.linkedin.com/in/zachary-ebert-422686a0/" target="_blank" class="subfooter-link last-subfooter-link">Linkedin</a>
          </div>
          <div class="footer-link-list-right">
            <a href="/" aria-current="page" class="subfooter-link last-subfooter-link w--current">© Ebert Design Co.</a>
          </div>
        </div>
      </div>
    </div>
  </div>
