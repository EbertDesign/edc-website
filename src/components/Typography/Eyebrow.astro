---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type EyebrowTag = "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * What the text is written as. Defaults to `p`. The type style is fixed
   * whichever is chosen, so a label can take a heading level — where it
   * titles the section that follows it — or `span`, where it is part of a
   * sentence, without changing how it looks.
   */
  tag?: EyebrowTag;
  /**
   * How the label is drawn.
   *
   * - `default` — a marker beside the text (default)
   * - `tag` — no marker; the text sits in a filled pill
   */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const Tag = tag;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class="eyebrow_text">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      /* The imported design: an 8px dot, and 48px of air beneath — the
         export carried both on a `.section-heading-container` wrapper that
         this component replaces. `no-margin-bottom` and the rotated sticky
         treatment are bare classes beside the root, as the export had them.

         This is the brand's label: Departure Mono, uppercase, at one of the
         two sizes it is legible at. Uppercase is set here rather than in the
         copy, so the text stays as it was written. */
      display: flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: 0.5rem;
      margin-bottom: 3rem;

      &.tag {
        background-color: var(--ink);
        color: var(--ground);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-small);
      }

      &.no-margin-bottom {
        margin-bottom: 0;
      }

      .eyebrow_marker {
        flex: none;
        width: 0.5rem;
        height: 0.5rem;
        /* A graphic mark, so it takes the mode's accent fill: signal-green
           on black, safety-orange on paper. A fill, never text, so orange is
           legal here. `--accent-fill` is `@property`-registered, so the
           homepage's scroll change fades it from one to the other. */
        background-color: var(--accent-fill);
        /* Square, to echo the pixel grid of Departure Mono beside it. */
        border-radius: 0;
      }

      .eyebrow_text {
        font-family: var(--font-pixel);
        font-size: var(--label);
        font-weight: 400;
        line-height: var(--label-line-height);
        letter-spacing: 0;
        text-transform: uppercase;
      }
    }

    /* A 4px optical nudge, so the marker lines up with the number beside it
       on the homepage's Approach grid. The export spelt this `margin-top-4`,
       which is the framework's own utility for `--space-4` (20-24px) — hence
       a name of its own rather than a shared one. */
    .eyebrow_wrap.eyebrow-offset {
      margin-top: 4px;
    }

    /* The export zeroed this utility's 12px on the label below the large
       breakpoint (`@media (max-width: 991px) .section-heading-container
       .margin-top-12`), so it is scoped to the component here too. */
    .eyebrow_wrap.margin-top-12 {
      margin-top: 0;
      @media (width >= 62rem) {
        margin-top: 12px;
      }
    }

    /* The case-studies label stands on its side and follows the scroll. */
    .eyebrow_wrap.sticky-rotated {
      margin-bottom: 0;
      @media (width >= 62rem) {
        position: sticky;
        top: 1.5rem;
        transform: rotate(90deg);
        transform-origin: 7% 60%;
      }
    }
  }
</style>
