---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/Media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** What it renders as. Defaults to `button`. */
      element?: "button";
      type?: "button" | "submit" | "reset";
      /** Greys it out and stops it responding. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Where the link goes. */
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /**
       * What kind of button it is.
       *
       * - `main` — a labelled button (default)
       * - `link` — text on a rule that travels across on hover
       * - `play`, `close`, `arrow` — a mark on its own, with a label for
       *   anyone who cannot see it
       */
      variant?: "main";
      /**
       * How much weight the button carries.
       *
       * - `primary` — filled, for the main action (default)
       * - `secondary` — outlined, for anything sitting beside a primary
       */
      emphasis?: Emphasis;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** What the control does, for anyone who cannot see its mark. Defaults to `Play`, or `Pause` when pressed is `true`. */
      label?: string;
      /** Whether it is playing: shows the pause mark, and reads as pressed. Defaults to `false`. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** What the control does, for anyone who cannot see its mark. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** What the control does, for anyone who cannot see its mark. Defaults to `Next`, or `Previous` when direction is `back`. */
      label?: string;
      pressed?: never;
      /** Which way the arrow points. Defaults to `forward`. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const content = isWritten ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{
  render && (isWritten ? content : true) && (
    <Tag
      class:list={[
        "button_wrap",
        emphasis !== "primary" && emphasis,
        variant !== "main" && variant,
        variant === "arrow" && direction === "back" && "back",
        className,
      ]}
      aria-label={isWritten ? undefined : (label ?? named[variant])}
      aria-pressed={variant === "play" ? pressed : undefined}
      {...tagAttrs}
      {...rest}
    >
      {isWritten && (
        <span class="button_text text-style-trim">
          <Fragment set:html={content} />
        </span>
      )}
      {variant === "play" && (
        <Fragment>
          <Icon class="button_mark button_play" src={play} variant="small" />
          <Icon class="button_mark button_pause" src={pause} variant="small" />
        </Fragment>
      )}
      {variant === "close" && (
        <Icon class="button_mark" src={marks.close} variant="small" />
      )}
      {(variant === "arrow" || variant === "main") && (
        <Icon class="button_mark" src={marks.arrow} variant="small" />
      )}
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button_wrap {
      /* The imported design's button: a brand pill that starts as a circle
         behind the arrow and grows across the label on hover. The pill is a
         pseudo-element, so the component keeps its own markup — the export
         used a spare `.button-background` div. Every labelled button on this
         site carries the arrow, so `main` renders one. */
      position: relative;
      z-index: 0;
      display: inline-flex;
      /* The export draws the arrow before the label; the component writes the
         label first, so the row is reversed rather than the markup. */
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: center;
      gap: 0.5rem;
      height: 4rem;
      max-width: 100%;
      margin-top: 3rem;
      padding: 0.5rem 1.75rem 0.5rem 1.25rem;
      color: var(--light-200);
      background-color: transparent;
      border: 0;
      border-radius: 0;
      line-height: 1.2;
      text-align: left;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);

      &::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset-block: 0;
        inset-inline-start: 0;
        width: 4rem;
        background-color: color-mix(in srgb, var(--light-100) 10%, transparent);
        border-radius: var(--radius-round);
        transition:
          width calc(var(--hover-duration) * 2) var(--hover-ease),
          background-color var(--hover-duration) var(--hover-ease);
      }

      /* A bare class beside the root, as the export had it. */
      &.no-margin-top {
        margin-top: 0;
      }

      .button_mark {
        --_size: 1.75rem;
        flex: none;
        color: var(--brand-500);
        transition: color var(--hover-duration) var(--hover-ease);
      }

      .button_text {
        /* The export set the case and weight on the button and let the label
           inherit them, which is easy to miss when reading `.button-text`
           alone: the labels are uppercase Syne 600, not sentence case. */
        font-family: var(--display-family);
        font-size: 0.875rem;
        font-weight: var(--primary-semibold);
        letter-spacing: 0.05rem;
        line-height: 1;
        text-transform: uppercase;
      }

      @media (hover: hover) {
        &:hover:not(:disabled) {
          &::before {
            width: 100%;
            background-color: var(--brand-500);
          }
          .button_mark,
          .button_text {
            color: var(--dark-900);
          }
        }
      }

      /* The framework's other emphases. The imported site uses none of them
         today, but they are the component's API and stay working: both drop
         the pill and fall back to the token-driven surface. */
      &:is(.secondary, .link) {
        height: auto;
        flex-direction: row;
        justify-content: center;
        color: var(--button-text);
        &::before {
          content: none;
        }
      }

      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);

        padding: 0.75em 1.5em;
        background-color: var(--button-background);
        border: var(--border-width) solid var(--button-border);
        border-radius: 0.5em;
        transition:
          background-color var(--hover-duration) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover:not(:disabled) {
            background-color: var(--button-background-hover);
            color: var(--button-text-hover);
            border-color: var(--button-border-hover);
          }
        }
      }

      &.link {
        --button-text: var(--link-text);
        --button-border: var(--link-border);
        --button-text-hover: var(--link-text-hover);

        padding: 0.4em 0;
        border-bottom: var(--border-width) solid var(--button-border);
        background-image: linear-gradient(
          var(--link-border-hover),
          var(--link-border-hover)
        );
        background-repeat: no-repeat;
        background-origin: border-box;
        background-position: 100% 100%;
        background-size: 0 var(--border-width);
        transition:
          background-size calc(var(--hover-duration) * 2) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover:not(:disabled) {
            color: var(--button-text-hover);
            background-position: 0 100%;
            background-size: 100% var(--border-width);
          }
        }
      }

      /* Icon-only controls — a slider's arrows, a modal's close, a marquee's
         play. These sit inside other components, so they take none of the
         labelled button's height, pill or margin. */
      &:is(.play, .close, .arrow) {
        flex-direction: row;
        justify-content: center;
        gap: 0;
        height: auto;
        margin-top: 0;
        padding: 0.75em;
        color: var(--button-text);
        background-color: var(--button-background);
        border: var(--border-width) solid var(--button-border);
        border-radius: var(--radius-round);
        transition:
          background-color var(--hover-duration) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease);
        &::before {
          content: none;
        }
        .button_mark {
          --_size: 1.5em;
          color: currentcolor;
        }
        @media (hover: hover) {
          &:hover:not(:disabled) {
            background-color: var(--button-background-hover);
            color: var(--button-text-hover);
            border-color: var(--button-border-hover);
          }
        }
      }

      &.back .button_mark {
        rotate: 180deg;
      }

      &.play .button_pause {
        display: none;
      }

      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }

      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
