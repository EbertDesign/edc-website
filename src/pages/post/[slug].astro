---
/**
 * PASS 3 — a journal post, from Sanity. The export's `detail_post.html` with
 * its placeholders bound to the `post` document. Same shared substitutions as
 * every pass-1 page. Becomes Lumos components in pass 2.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SanityImg from "@/components/Media/SanityImg.astro";
import PortableText from "@/components/Typography/PortableText.astro";
import CtaContact from "@/components/ContentCtaContact.astro";
import FormattedDate from "@/components/Utility/FormattedDate.astro";
import { sanityClient, POST_DETAIL_QUERY } from "@/utils/sanity.ts";

export async function getStaticPaths() {
  const { sanityClient, POST_SLUGS_QUERY } = await import("@/utils/sanity.ts");
  const slugs = await sanityClient.fetch(POST_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const p = await sanityClient.fetch(POST_DETAIL_QUERY, { slug });
if (!p) throw new Error(`No document for /${Astro.url.pathname}`);
---

<BaseLayout title={p.title} type="article">
  <div class="wf-section subpage-hero-section">
    <div class="wf-container">
      <div class="w-layout-grid _12-column-grid">
        <div class="fade-in-bottom cell-post-head">
          <a href="/journal" class="subtle-text-link">Back to journal</a>
          <h1 class="margin-bottom-64 margin-top-48">{p.title}</h1>
          <div class="blog-subtext-contain">
            <p class="text-large light-grey-text">{p.topic}</p>
            <p class="text-large light-grey-text">
              {p.publishedAt && <FormattedDate date={new Date(p.publishedAt)} />}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {p.mainImage?.asset && (
    <div class="wf-section">
      <div class="wf-container">
        <SanityImg image={p.mainImage} sizes="(min-width: 62rem) 81vw, 100vw" />
      </div>
    </div>
  )}

  {p.body && (
    <div class="wf-section">
      <div class="wf-container">
        <PortableText value={p.body} />
      </div>
    </div>
  )}

  <CtaContact />
</BaseLayout>
