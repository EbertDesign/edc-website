---
/**
 * PASS 1 — /info/instructions, as Webflow exported it, with only the shared substitutions
 * applied: paths rewritten, the nine colliding class names prefixed `wf-`,
 * `data-w-id` stripped (IX2 is gone; `.fade-in-bottom` plays through
 * `Utility/Reveal`), and the chrome supplied by `BaseLayout`.
 * Every other class is still the template's own and every rule still lives in
 * `styles/webflow/site.css`. Becomes Lumos components in pass 2, one block at a
 * time, against this baseline.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Instructions"
>
  <div class="wf-section margin-top-80">
      <div class="wf-container">
        <h1 class="styleguide-heading">Licenses</h1>
        <div class="divider styleguide-bottom-divider"></div>
      </div>
    </div>

  <div class="wf-section">
      <div class="wf-container">
        <div class="styleguide-heading-wrapper">
          <h2 class="text-large wf-margin-bottom-8">Grid</h2>
          <p class="light-grey-text">The layout is primarily based on a 12 column grid system. Simply use the class &quot;12 Column Grid&quot; too add the basic styling to your grid component. </p>
        </div>
        <div class="divider styleguide-bottom-divider"></div>
      </div>
    </div>

  <div class="wf-section">
      <div class="wf-container">
        <div class="styleguide-heading-wrapper">
          <h2 class="text-large wf-margin-bottom-8">Typography</h2>
          <p class="light-grey-text">This template uses the fonts Switzer and Clash Display from Fontshare- <br />You can get this font under an open licence <a href="https://www.fontshare.com/fonts/switzer">here.</a>
          </p>
        </div>
        <div class="divider styleguide-bottom-divider"></div>
      </div>
    </div>

  <div class="wf-section">
      <div class="wf-container">
        <div class="styleguide-heading-wrapper">
          <h2 class="text-large wf-margin-bottom-8">SVG Icons</h2>
          <p class="light-grey-text">This template uses embedded SVG Icons in the link blocks (buttons). This is done to be able to switch the color of the icon on hover. <br /><br />In order to change the icons all you need to do is: <br />1. Export your SVG-icon<br />2. Open it in a text editor and copy the SVG code<br />3. Paste the SVG code in the embed components within the link blocks<br />4. In the SVG code make sure to set the color of your icon to &quot;currentcolor&quot; in order for the icon to follow the color of the text. </p>
        </div>
        <div class="divider styleguide-bottom-divider"></div>
      </div>
    </div>

  <div class="wf-section">
      <div class="wf-container">
        <div class="styleguide-heading-wrapper">
          <h2 class="text-large wf-margin-bottom-8">Image licenses</h2>
          <p class="light-grey-text">All graphical assets in this template are licensed for personal and commercial use. If you&#x27;d like to use a specific asset, please check the license below. <br /><br />All photography sourced from Unsplash and Freepik and fall under the <a href="https://unsplash.com/license/" target="_blank">Unsplash license </a>and the<a href="https://www.freepikcompany.com/legal?_gl=1*1a0pias*fp_ga*MTU1NTc1MjM1LjE2NDUyNzY2ODg.*fp_ga_QWX66025LC*MTY0OTI3NDI3Ni4xMy4wLjE2NDkyNzQyODQuNTI.*_ga*MTA0NzMwNzA4My4xNjQ1Mjc0NTcy*_ga_18B6QPTJPC*MTY0OTI3NDI3Ni4xMy4wLjE2NDkyNzQyNzYuNjA.#nav-freepik-license" target="_blank"> Freepik license</a>
          </p>
        </div>
      </div>
    </div>
</BaseLayout>
