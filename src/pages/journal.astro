---
/**
 * /journal. Sections are `Wrapper/Section`, labels `Typography/Eyebrow`, buttons
 * `Button`; the collection lists are bound to Sanity (see `utils/sanity.ts`),
 * the entrance animations play through `Utility/Reveal` rather than Webflow's
 * IX2, and the chrome comes from `BaseLayout`.
 * What is still the export's own is the twelve-column grid (`_12-column-grid`
 * and the `#w-node-…` placements it needs) and the site's utility classes —
 * both deliberate: they are this design's layout system, and the framework's
 * `Grid` expresses column counts rather than named areas.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Button from "@/components/Button.astro";
import SanityImg from "@/components/Media/SanityImg.astro";
import { sanityClient, POSTS_LIST_QUERY } from "@/utils/sanity.ts";
const posts = await sanityClient.fetch(POSTS_LIST_QUERY);
---

<BaseLayout
  title="Journal"
>
  <Section paddingTop="none" paddingBottom="none" class="subpage-hero-section" gap="0">
        <div class="w-layout-grid _12-column-grid fade-in-bottom">
          <div id="w-node-_7e2df456-056c-c30b-ccc3-318453d4a487-08125e5a">
            <h1 class="journal-hero-title">Our journal</h1>
            <p class="text-large">Our thoughts on purpose, process, and the power of an agency that works for good.</p>
          </div>
          <p id="w-node-_7e2df456-056c-c30b-ccc3-318453d4a48c-08125e5a" class="light-grey-text text-style-label">News and insights</p>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <div class="w-dyn-list">
          <div role="list" class="journal-list w-dyn-items">
            {posts.map((p) => (
              <div role="listitem" class="w-dyn-item">
                <a href={`/post/${p.slug}`} class="journal-post-container fade-in-bottom w-inline-block">
                  <div class="journal-post-heading-container">
                    <h2 class="journal-post_title">{p.title}</h2>
                    <p class="margin-top-16 light-grey-text text-style-label">{p.topic}</p>
                  </div>
                  <SanityImg image={p.mainImage} loading="eager" class="journal-post-image" sizes="(min-width: 62rem) 40vw, 100vw" />
                </a>
              </div>
            ))}
          </div>
        </div>
  </Section>

  <Section paddingTop="none" containerClass="fade-in-bottom" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-_65b5bba4-9c92-97d4-8cf2-1147ca561a3a-ca561a36" class="center-text">
            <p class="text-5xl">Let&#x27;s<br />elevate your<br />‍<span class="primary-text">impact.</span> </p>
            <Button element="link" href="/contact">Get in touch</Button>
          </div>
        </div>
  </Section>
</BaseLayout>

<style>
  /* Room between the hero title and its intro line; the descender on "j"
     sat almost on top of the text at the export's 16px. */
  .journal-hero-title {
    margin-bottom: var(--space-6);
  }

  /* The post's image stays out of sight until its row is hovered or focused,
     then glitches in; it glitches back out when the pointer leaves. Stepped on
     purpose, not eased: each keyframe holds, cutting the image into bands and
     knocking it sideways until it settles. Under `prefers-reduced-motion`
     `base.css` collapses the duration, so it swaps in and out with no frames.
     `data-glitched` is set by the script below on first hover, so the leave
     animation cannot play on page load. */
  .journal-post-image {
    opacity: 0;
  }

  .journal-post-container:is(:hover, :focus-visible) .journal-post-image {
    opacity: 1;
    animation: journal-glitch-in 440ms steps(1, end) both;
  }

  .journal-post-container[data-glitched]:not(:hover, :focus-visible) .journal-post-image {
    animation: journal-glitch-out 280ms steps(1, end) both;
  }

  @keyframes journal-glitch-in {
    0% {
      opacity: 1;
      clip-path: inset(62% 0 30% 0);
      transform: translateX(-6%);
    }
    12% {
      opacity: 1;
      clip-path: inset(10% 0 76% 0);
      transform: translateX(4%);
    }
    24% {
      opacity: 1;
      clip-path: polygon(0 28%, 100% 28%, 100% 41%, 0 41%, 0 70%, 100% 70%, 100% 88%, 0 88%);
      transform: translateX(-3%);
    }
    36% {
      opacity: 0;
      clip-path: inset(0);
      transform: none;
    }
    46% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 34%, 0 34%, 0 55%, 100% 55%, 100% 64%, 0 64%);
      transform: translateX(2.5%);
    }
    58% {
      opacity: 1;
      clip-path: inset(0 0 22% 0);
      transform: translateX(-1.5%);
    }
    70% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 57%, 0 57%, 0 66%, 100% 66%, 100% 100%, 0 100%);
      transform: translateX(1%);
    }
    82% {
      opacity: 1;
      clip-path: inset(0);
      transform: translateX(-0.5%);
    }
    100% {
      opacity: 1;
      clip-path: inset(0);
      transform: none;
    }
  }

  @keyframes journal-glitch-out {
    0% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 48%, 0 48%, 0 60%, 100% 60%, 100% 100%, 0 100%);
      transform: translateX(1.5%);
    }
    20% {
      opacity: 1;
      clip-path: polygon(0 8%, 100% 8%, 100% 30%, 0 30%, 0 52%, 100% 52%, 100% 79%, 0 79%);
      transform: translateX(-3%);
    }
    40% {
      opacity: 0;
      clip-path: inset(0);
      transform: none;
    }
    55% {
      opacity: 1;
      clip-path: inset(36% 0 44% 0);
      transform: translateX(5%);
    }
    75% {
      opacity: 1;
      clip-path: inset(80% 0 9% 0);
      transform: translateX(-6%);
    }
    100% {
      opacity: 0;
      clip-path: inset(0);
      transform: none;
    }
  }
</style>

<script>
  // Marks a journal row the first time it is hovered or focused, which is
  // what lets its image glitch out afterwards (see the styles above).
  // Delegated, so it holds for rows swapped in by a page transition.
  const mark = (event: Event) => {
    const row = (event.target as Element | null)?.closest?.<HTMLElement>(".journal-post-container");
    if (row) row.dataset.glitched = "";
  };
  document.addEventListener("pointerover", mark, { passive: true });
  document.addEventListener("focusin", mark);
</script>
