---
/**
 * /journal. Sections are `Wrapper/Section`, labels `Typography/Eyebrow`, buttons
 * `Button`; the collection lists are bound to Sanity (see `utils/sanity.ts`),
 * the entrance animations play through `Utility/Reveal` rather than Webflow's
 * IX2, and the chrome comes from `BaseLayout`.
 * What is still the export's own is the twelve-column grid (`_12-column-grid`
 * and the `#w-node-…` placements it needs) and the site's utility classes —
 * both deliberate: they are this design's layout system, and the framework's
 * `Grid` expresses column counts rather than named areas.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Button from "@/components/Button.astro";
import SanityImg from "@/components/Media/SanityImg.astro";
import { sanityClient, POSTS_LIST_QUERY } from "@/utils/sanity.ts";
const posts = await sanityClient.fetch(POSTS_LIST_QUERY);
---

<BaseLayout
  title="Journal"
>
  <Section paddingTop="none" paddingBottom="none" class="subpage-hero-section" gap="0">
        <div class="w-layout-grid _12-column-grid fade-in-bottom">
          <div id="w-node-_7e2df456-056c-c30b-ccc3-318453d4a487-08125e5a">
            <h1 class="margin-bottom-16">Our journal</h1>
            <p class="text-large">Our thoughts on purpose, process, and the power of an agency that works for good.</p>
          </div>
          <p id="w-node-_7e2df456-056c-c30b-ccc3-318453d4a48c-08125e5a" class="light-grey-text text-s">News and insights</p>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <div class="w-dyn-list">
          <div role="list" class="journal-list w-dyn-items">
            {posts.map((p) => (
              <div role="listitem" class="w-dyn-item">
                <a href={`/post/${p.slug}`} class="journal-post-container fade-in-bottom w-inline-block">
                  <div class="journal-post-heading-container">
                    <h2 class="journal-post_title">{p.title}</h2>
                    <p class="margin-top-16 light-grey-text">{p.topic}</p>
                  </div>
                  <SanityImg image={p.mainImage} loading="eager" class="journal-post-image" sizes="(min-width: 62rem) 40vw, 100vw" />
                </a>
              </div>
            ))}
          </div>
        </div>
  </Section>

  <Section paddingTop="none" containerClass="fade-in-bottom" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-_65b5bba4-9c92-97d4-8cf2-1147ca561a3a-ca561a36" class="center-text">
            <p class="text-5xl">Let&#x27;s<br />elevate your<br />‍<span class="primary-text">impact.</span> </p>
            <Button element="link" href="/contact">Get in touch</Button>
          </div>
        </div>
  </Section>
</BaseLayout>
