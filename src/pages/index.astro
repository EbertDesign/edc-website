---
/**
 * The `/` route, and nothing else. The homepage itself is `Home.astro` —
 * kept under that name because the site calls this page Home — and since
 * Astro routes by filename, this file is what serves it from the site root.
 *
 * `Home.astro` stays a page of its own, so `/Home` answers with the same
 * markup. It is listed in `NOINDEX_ROUTES` so the copy at `/` is the only
 * one indexed or listed in the sitemap.
 */
import Home from "./Home.astro";
---

<Home />
