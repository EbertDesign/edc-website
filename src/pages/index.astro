/**
 * PASS 1 — the homepage exactly as Webflow exported it: the seven sections
 * that sat between the nav and the footer, with only paths rewritten
 * (`images/` -> `/images/`, `*.html` -> routes). Every class is still the
 * template's own and every rule still comes from `styles/webflow/site.css`.
 *
 * This file is the baseline the pass-2 component swaps are measured against,
 * so nothing here is tidied until that comparison has been made.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";

