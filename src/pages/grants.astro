---
/**
 * /grants. Sections are `Wrapper/Section`, labels `Typography/Eyebrow`, buttons
 * `Button`; the entrance animations play through `Utility/Reveal` rather than
 * Webflow's IX2, and the chrome comes from `BaseLayout`.
 * What is still the export's own is the twelve-column grid (`_12-column-grid`
 * and the `#w-node-…` placements it needs) and the site's utility classes —
 * both deliberate: they are this design's layout system, and the framework's
 * `Grid` expresses column counts rather than named areas.
 *
 * Webflow widgets still in this markup, non-functional until pass 2: w-form.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Form from "@/components/Form/Form.astro";
import Input from "@/components/Form/Input.astro";
import Textarea from "@/components/Form/Textarea.astro";
import Select from "@/components/Form/Select.astro";
import Button from "@/components/Button.astro";
import Section from "@/components/Wrapper/Section.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
---

<BaseLayout
  title="Grants Program"
>
  <Section paddingTop="none" paddingBottom="none" class="subpage-hero-section" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-_8fbd3dcc-fa3e-6813-474c-125f8b4765b3-4efe135b">
            <h1 class="margin-bottom-16 fade-in-bottom">Grant-Funded Projects </h1>
            <p class="text-large fade-in-bottom-100ms">Transform Your Nonprofit&#x27;s Brand Without Burdening Your Budget.</p>
          </div>
          <p id="w-node-_8fbd3dcc-fa3e-6813-474c-125f8b4765b8-4efe135b" class="light-grey-text text-s fade-in-bottom-100ms">Grant Funded Marketing Services.</p>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <div class="w-layout-grid _12-column-grid margin-top-80 fade-in-bottom">
          <p id="w-node-_0b6d86bf-965f-099f-adc5-d33ffb8abc4e-4efe135b" class="text-2xl">None of the Risk, All the Reward.</p>
          <p id="w-node-_0b6d86bf-965f-099f-adc5-d33ffb8abc50-4efe135b" class="light-grey-text text-2-columns">Your mission deserves powerful design that moves people to action. But when every dollar counts, investing in professional branding often takes a backseat to program delivery. What if you could secure grant funding specifically for the brand and marketing your nonprofit needs? Introducing our Grant-Funded Design Program where we pair our purpose-driven design expertise with specialized grant writing to help nonprofits like yours access foundation funding for communication projects.</p>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <div class="w-layout-grid _12-column-grid margin-bottom-64 fade-in-bottom">
          <p id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d62d-4efe135b" class="text-4xl">How It Works.</p>
          <Eyebrow id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d631-4efe135b" tag="h2" class="no-margin-bottom">Application Processs</Eyebrow>
        </div>
        <div class="list-container fade-in-bottom">
          <div class="list-item-container">
            <p>01</p>
            <div id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d63a-4efe135b">
              <h3>Evaluate Needs.</h3>
              <p id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d63d-4efe135b" class="light-grey-text">Complete our quick interest form below to get started. After you fill out the form a team member will reach out to set up a brief screening call.</p>
            </div>
          </div>
          <div class="list-item-container">
            <p>02</p>
            <div id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d642-4efe135b">
              <h3>Find Funding.</h3>
              <p id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d645-4efe135b" class="light-grey-text">After a brief screening call, our team matches your project with relevant grant opportunities from our continually updated funding calendar.</p>
            </div>
          </div>
          <div class="list-item-container">
            <p>03</p>
            <div id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d64a-4efe135b">
              <h3>Secure Professional Support.</h3>
              <p id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d64d-4efe135b" class="light-grey-text">Our grant writing partners prepare compelling applications while Ebert Design scopes your project for maximum impact. </p>
            </div>
          </div>
          <div class="list-item-container">
            <p>04</p>
            <div id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d652-4efe135b">
              <h3>Create Meaningful Design.</h3>
              <p id="w-node-_55e80e1b-cee2-ede3-7605-8af019d1d655-4efe135b" class="light-grey-text">Once funding is secured, our team of nonprofit design specialists brings your vision to life with purpose-driven brand solutions, brand strategy, and more.</p>
            </div>
          </div>
        </div>
  </Section>

  <Section paddingTop="none" paddingBottom="none" class="subpage-hero-section" gap="0">
        <div class="w-layout-grid _12-column-grid hero-grid fade-in-bottom">
          <div id="w-node-_9e961965-b3d4-c979-158b-6b368a77fef4-4efe135b">
            <p class="text-5xl margin-bottom-16">Get Started Today.</p>
            <p class="text-large">Complete our brief interest form below, and a member of our team will reach out to discuss your nonprofit&#x27;s needs and potential grant opportunities.</p>
          </div>
          <Eyebrow id="w-node-_9e961965-b3d4-c979-158b-6b368a77fef9-4efe135b" tag="h1" class="no-margin-bottom">Interest Form</Eyebrow>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-e59bf35f-85b5-1810-e6c2-bd74ff696572-4efe135b" class="from-block w-form">
            <Form
          name="Grant Funded Project Form"
          successMessage="Thank you! Your submission has been received!"
          errorMessage="Oops! Something went wrong while submitting the form."
        >
          <Input variant="first-name" name="First-Name" label="First Name" placeholder="First Name" required />
          <Input variant="last-name" name="Last-Name" label="Last Name" placeholder="Last Name" required />
          <Input variant="email" name="Email" label="Email" placeholder="Your email" required />
          <Input name="Organization" label="Organization Name" placeholder="Your Organization" required />
          <Input variant="url" name="Website" label="Organization Website" placeholder="Your Organization" required />
          <Select
            name="Operating-Budget"
            label="Annual Operating Budget"
            placeholder="Select one..."
            required
            options={[
              "Under $100,000",
              "$100,000 - $250,000",
              "$250,001 - $500,000",
              "$500,001 - $1 million",
              "$1 million - $2.5 million",
              "$2.5 million - $5 million",
              "Over $5 million",
              "Prefer not to disclose",
            ]}
          />
          <Select
            name="Primary-Interest-In-Services"
            label="Primary Interest In Services"
            placeholder="Select one..."
            required
            options={["Branding", "Web Design & Development", "Marketing Campigns", "Other (Expand Below)"]}
          />
          <Select
            name="Timeline"
            label="Timeline For Projects"
            placeholder="Select one..."
            options={["Immediate", "3-6 months", "6-12 months", "No Current Timeline"]}
          />
          <Input name="Referral-Source" label="How did you hear about us?" placeholder="Type Here." />
          <Textarea
            name="Project"
            label="Tell Us About The Project (Project Details, Scope, Timeline)"
            placeholder="Tell us about your project..."
            required
          />
          <Button element="button" type="submit" class="submit">Submit your Project</Button>
        </Form>

          </div>
          <div id="w-node-e59bf35f-85b5-1810-e6c2-bd74ff696587-4efe135b">
            <div class="margin-bottom-16">
              <p>Address</p>
              <p class="light-grey-text">Montgomery,<br />Alabama</p>
            </div>
            <div class="margin-bottom-16">
              <p>Contact</p>
              <p class="light-grey-text">info@ebertdesign.co<br /></p>
            </div>
            <div>
              <p>Grant Writer?</p>
              <p class="light-grey-text text-s margin-bottom-16">are you a grant writer looking to partner with us? Send us an email using the address below.</p>
              <p class="light-grey-text">zach@ebertdesign.co<br /></p>
            </div>
          </div>
        </div>
  </Section>
</BaseLayout>
