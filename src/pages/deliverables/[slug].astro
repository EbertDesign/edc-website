---
/**
 * PASS 3 — a deliverable, from Sanity. The export's `detail_deliverables.html`
 * with its placeholders bound to the `deliverable` document. The template
 * shipped with lorem ipsum in the summary block; the real subtitle and
 * description go there. Same shared substitutions as every pass-1 page.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SanityImg from "@/components/Media/SanityImg.astro";
import CtaContact from "@/components/ContentCtaContact.astro";
import { sanityClient, DELIVERABLE_DETAIL_QUERY } from "@/utils/sanity.ts";

export async function getStaticPaths() {
  const { sanityClient, DELIVERABLE_SLUGS_QUERY } = await import("@/utils/sanity.ts");
  const slugs = await sanityClient.fetch(DELIVERABLE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const d = await sanityClient.fetch(DELIVERABLE_DETAIL_QUERY, { slug });
if (!d) throw new Error(`No document for /${Astro.url.pathname}`);
---

<BaseLayout title={d.title} description={d.description ?? undefined} overlap>
  <div class="wf-section">
    <div class="wf-container hero-top-container">
      <div class="hero-image-container">
        <SanityImg image={d.image} loading="eager" class="hero-image" alt="" />
      </div>
      <div class="w-layout-grid _12-column-grid">
        <div class="subpage-hero-text-container fade-in-bottom hero-cell-title">
          <div class="section-heading-container">
            <div class="section-heading-content">
              <div class="dot"></div>
              <p class="text-s">Deliverable</p>
            </div>
          </div>
          <h1>{d.title}</h1>
        </div>
      </div>
    </div>
  </div>

  <div class="wf-section">
    <div class="wf-container">
      <div class="w-layout-grid _12-column-grid margin-top-80 fade-in-bottom">
        <p class="text-2xl cell-summary-lead">{d.subtitle}</p>
        <p class="light-grey-text text-2-columns cell-summary-body">{d.description}</p>
        <p class="text-s light-grey-text margin-top-12 cell-summary-label">About</p>
      </div>
    </div>
  </div>

  <CtaContact />
</BaseLayout>
