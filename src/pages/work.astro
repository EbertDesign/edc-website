---
/**
 * /work. Sections are `Wrapper/Section`, labels `Typography/Eyebrow`, buttons
 * `Button`; the collection lists are bound to Sanity (see `utils/sanity.ts`),
 * the entrance animations play through `Utility/Reveal` rather than Webflow's
 * IX2, and the chrome comes from `BaseLayout`.
 * What is still the export's own is the twelve-column grid (`_12-column-grid`
 * and the `#w-node-…` placements it needs) and the site's utility classes —
 * both deliberate: they are this design's layout system, and the framework's
 * `Grid` expresses column counts rather than named areas.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import CaseCard from "@/components/Item/CaseCard.astro";
import { sanityClient, CASES_LIST_QUERY } from "@/utils/sanity.ts";
const cases = await sanityClient.fetch(CASES_LIST_QUERY);
---

<BaseLayout
  title="Cases"
>
  <Section paddingTop="none" paddingBottom="none" class="subpage-hero-section" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-f2af4ad2-83de-3ec5-1287-428a56799375-08125e5e">
            <h1 class="margin-bottom-16 fade-in-bottom">Blood, Sweat &amp; Insights</h1>
            <p class="text-large fade-in-bottom-100ms">Through our work, Ebert Design prepares your brand for cultural relevance and worldwide impact.</p>
          </div>
          <p id="w-node-aaa883df-d212-2a93-8f71-8384e5254948-08125e5e" class="light-grey-text text-s fade-in-bottom-100ms">2016-2025</p>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <Eyebrow tag="h2">See all our cases</Eyebrow>
        <div class="w-layout-grid _12-column-grid">
          <div class="projects w-dyn-list cases-cell">
            <div role="list" class="projects-list w-dyn-items">
              {cases.map((c) => <CaseCard case={c} variant="subpage" />)}
            </div>
          </div>
        </div>
  </Section>

  <Section paddingTop="none" containerClass="fade-in-bottom" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-_65b5bba4-9c92-97d4-8cf2-1147ca561a3a-ca561a36" class="center-text">
            <p class="text-5xl">Let&#x27;s<br />elevate your<br />‍<span class="primary-text">impact.</span> </p>
            <Button element="link" href="/contact">Get in touch</Button>
          </div>
        </div>
  </Section>
</BaseLayout>
