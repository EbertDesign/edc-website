---
/**
 * /work. Sections are `Wrapper/Section`, labels `Typography/Eyebrow`, buttons
 * `Button`; the collection lists are bound to Sanity (see `utils/sanity.ts`),
 * the entrance animations play through `Utility/Reveal` rather than Webflow's
 * IX2, and the chrome comes from `BaseLayout`.
 * What is still the export's own is the twelve-column grid (`_12-column-grid`
 * and the `#w-node-…` placements it needs) and the site's utility classes —
 * both deliberate: they are this design's layout system, and the framework's
 * `Grid` expresses column counts rather than named areas.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import CaseCard from "@/components/Item/CaseCard.astro";
import { sanityClient, CASES_LIST_QUERY } from "@/utils/sanity.ts";
const cases = await sanityClient.fetch(CASES_LIST_QUERY);
---

<BaseLayout
  title="Work"
>
  <Section paddingTop="none" paddingBottom="none" class="subpage-hero-section" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-f2af4ad2-83de-3ec5-1287-428a56799375-08125e5e">
            <h1 class="work-hero-title fade-in-bottom">Blood, Sweat&nbsp;&amp; Insights</h1>
            <p class="text-large fade-in-bottom-100ms">Through our work, Ebert Design prepares your brand for cultural relevance and worldwide impact.</p>
          </div>
          <p id="w-node-aaa883df-d212-2a93-8f71-8384e5254948-08125e5e" class="light-grey-text text-style-label fade-in-bottom-100ms">2016-2025</p>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <Eyebrow tag="h2">See all our cases</Eyebrow>
        <div class="w-layout-grid _12-column-grid">
          <div class="projects w-dyn-list cases-cell">
            <div role="list" class="projects-list w-dyn-items" data-batch-list data-batch-size="6">
              {cases.map((c) => <CaseCard case={c} variant="subpage" />)}
            </div>
            <div data-batch-sentinel aria-hidden="true"></div>
          </div>
        </div>
  </Section>

  <Section paddingTop="none" containerClass="fade-in-bottom" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-_65b5bba4-9c92-97d4-8cf2-1147ca561a3a-ca561a36" class="center-text">
            <p class="text-5xl">Let&#x27;s<br />elevate your<br />‍<span class="primary-text">impact.</span> </p>
            <Button element="link" href="/contact">Get in touch</Button>
          </div>
        </div>
  </Section>
</BaseLayout>

<style>
  /* Same room under the hero title as /journal and /grants. */
  .work-hero-title {
    margin-bottom: var(--space-6);
  }

  /* A card waiting for its batch. `.case` sets its own `display`, which
     outranks the browser's `[hidden]` rule, so it is restated here. */
  .projects-list :global(.case[hidden]) {
    display: none;
  }
</style>

<script>
  /* Load on scroll. Every case is in the HTML — the page is static, and the
     cards' hover scripts bind once at load — so nothing is fetched: cards past
     the first batch are hidden, and the next batch is shown when the sentinel
     under the list comes within a viewport of the screen, early enough that
     the reader never reaches the end of the list. Each card still fades up
     through `Utility/Reveal` and its image is still `loading="lazy"`, so a
     batch costs nothing until it is shown.

     With no JavaScript nothing is hidden and the whole list is there. */
  const list = document.querySelector<HTMLElement>("[data-batch-list]");
  const sentinel = document.querySelector<HTMLElement>("[data-batch-sentinel]");

  if (list && sentinel && "IntersectionObserver" in window) {
    const size = Number(list.dataset.batchSize) || 6;
    const cards = Array.from(list.querySelectorAll<HTMLElement>(":scope > .case"));

    /* Coming back from a case, the browser restores the scroll position — so
       restore the number of cards that were showing first, or there is no
       page that far down to return to. */
    let shown = Math.min(cards.length, Math.max(size, Number(history.state?.casesShown) || 0));

    const apply = () => cards.forEach((card, i) => (card.hidden = i >= shown));
    apply();

    if (shown < cards.length) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          shown = Math.min(cards.length, shown + size);
          apply();
          history.replaceState({ ...history.state, casesShown: shown }, "");

          /* Re-observing reports the sentinel afresh, so a batch too short
             to push it out of range is followed by the next one. */
          observer.unobserve(sentinel);
          if (shown < cards.length) observer.observe(sentinel);
        },
        /* A viewport of lead below, and no limit above: jumping to the end of
           the page (End key, dragging the scrollbar) passes the sentinel
           without ever crossing the screen, and must still count. */
        { rootMargin: "1000000px 0px 100% 0px" },
      );
      observer.observe(sentinel);
    }
  }
</script>
