---
/**
 * PASS 3 — a case study, from Sanity. The markup is the export's
 * `detail_case.html` template with the `w-dyn-bind-empty` placeholders bound
 * to the `caseStudy` document; the same shared substitutions as every other
 * pass-1 page (paths, `wf-` prefix, `data-w-id` stripped, chrome from
 * `BaseLayout`). Becomes Lumos components in pass 2 like the rest.
 *
 * The deliverable pop-ups were IX2-driven on Webflow and do nothing yet.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SanityImg from "@/components/Media/SanityImg.astro";
import PortableText from "@/components/Typography/PortableText.astro";
import CtaContact from "@/components/ContentCtaContact.astro";
import CaseCard from "@/components/Item/CaseCard.astro";
import { sanityClient, CASE_DETAIL_QUERY } from "@/utils/sanity.ts";

export async function getStaticPaths() {
  const { sanityClient, CASE_SLUGS_QUERY } = await import("@/utils/sanity.ts");
  const slugs = await sanityClient.fetch(CASE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const c = await sanityClient.fetch(CASE_DETAIL_QUERY, { slug });
if (!c) throw new Error(`No document for /${Astro.url.pathname}`);
---

<BaseLayout title={c.title} description={c.description ?? undefined} overlap>
  <div class="wf-section">
    <div class="wf-container hero-top-container">
      <div class="hero-image-container">
        <SanityImg image={c.thumbnail} loading="eager" class="hero-image" alt="" />
      </div>
      <div class="w-layout-grid _12-column-grid">
        <div class="subpage-hero-text-container fade-in-bottom hero-cell-title">
          <a href="/work" class="subtle-text-link">Back to cases</a>
          <h1 class="text-7xl margin-top-64">{c.title}</h1>
        </div>
      </div>
    </div>
  </div>

  <div class="wf-section margin-bottom-120">
    <div class="wf-container">
      <div class="w-layout-grid _12-column-grid margin-top-80 fade-in-bottom">
        <p class="text-2xl cell-summary-lead">{c.subheading}</p>
        <p class="light-grey-text text-2-columns cell-summary-body">{c.description}</p>
        <p class="text-s light-grey-text margin-top-12 cell-summary-label">Summary</p>
      </div>
    </div>
  </div>

  <div class="wf-section">
    <div class="wf-container">
      <div class="w-layout-grid _12-column-grid margin-top-80">
        <div class="section-heading-container no-margin-bottom cell-list-label">
          <div class="section-heading-content">
            <div class="dot"></div>
            <h2 class="text-s">Deliverables</h2>
          </div>
        </div>
        <div class="deliverables-container w-dyn-list cell-list-body">
          <div role="list" class="w-dyn-items">
            {(c.deliverables ?? []).map((d) => (
              <div role="listitem" class="deliverable-container w-dyn-item">
                <div class="popup">
                  <SanityImg image={d.image} class="popup_image" sizes="(min-width: 62rem) 50vw, 100vw" />
                  <div class="popup__content">
                    <a href="#" class="popup__close w-inline-block"><img src="/images/X.svg" loading="lazy" alt="" class="popup__icon" /></a>
                    <div class="section-heading-content margin-bottom-64">
                      <div class="dot"></div>
                      <h2 class="text-s">Deliverables</h2>
                    </div>
                    <h2 class="margin-bottom-64">{d.title}</h2>
                    <h5 class="margin-bottom-16">{d.subtitle}</h5>
                    <p class="light-grey-text">{d.description}</p>
                  </div>
                </div>
                <a href={`/deliverables/${d.slug}`} class="deliverables-list-container w-inline-block">
                  <p class="text-xl">{d.title}</p>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  {c.process && (
    <div class="wf-section margin-bottom-120">
      <div class="wf-container">
        <div class="w-layout-grid _12-column-grid margin-top-80 fade-in-bottom">
          <div class="section-heading-content cell-story-label">
            <div class="dot"></div>
            <h2 class="text-s">Process</h2>
          </div>
          <div class="cell-story-body">
            <PortableText value={c.process} />
          </div>
        </div>
      </div>
    </div>
  )}

  {c.gallery && c.gallery.length > 0 && (
    <div class="wf-section">
      <div class="wf-container">
        <div class="w-dyn-list">
          <div role="list" class="images-grid w-dyn-items">
            {c.gallery.map((img) => (
              <div role="listitem" class="project-image w-dyn-item">
                <SanityImg image={img} class="fade-in-bottom" sizes="(min-width: 62rem) 50vw, 100vw" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  {c.impact && (
    <div class="wf-section margin-bottom-120">
      <div class="wf-container">
        <div class="w-layout-grid _12-column-grid margin-top-80 fade-in-bottom">
          <div class="section-heading-content cell-story-label">
            <div class="dot"></div>
            <h2 class="text-s">Impact</h2>
          </div>
          <div class="cell-story-body">
            <PortableText value={c.impact} />
          </div>
        </div>
      </div>
    </div>
  )}

  {c.next && (
    <div class="wf-section">
      <div class="wf-container">
        <div class="w-layout-grid _12-column-grid">
          <p class="text-4xl fade-in-bottom cell-next-lead">Want to see more?</p>
          <div class="section-heading-container no-margin-bottom cell-next-label">
            <div class="section-heading-content">
              <div class="dot"></div>
              <h2 class="text-s">Next case</h2>
            </div>
          </div>
          <div class="projects w-dyn-list cell-next-body">
            <div role="list" class="projects-list w-dyn-items">
              <CaseCard case={c.next} />
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <CtaContact />
</BaseLayout>
