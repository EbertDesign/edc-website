---
/**
 * PASS 1 — /contact, as Webflow exported it, with only the shared substitutions
 * applied: paths rewritten, the nine colliding class names prefixed `wf-`,
 * `data-w-id` stripped (IX2 is gone; `.fade-in-bottom` plays through
 * `Utility/Reveal`), and the chrome supplied by `BaseLayout`.
 * Every other class is still the template's own and every rule still lives in
 * `styles/webflow/site.css`. Becomes Lumos components in pass 2, one block at a
 * time, against this baseline.
 *
 * Webflow widgets still in this markup, non-functional until pass 2: w-form.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
>
  <div class="wf-section subpage-hero-section">
      <div class="wf-container">
        <div class="w-layout-grid _12-column-grid hero-grid fade-in-bottom">
          <div id="w-node-_490b76ab-b07c-0ba2-dfe3-385728885767-08125e52">
            <p class="text-5xl margin-bottom-16">Work with us today.</p>
            <p class="text-large">Ready to work together? Fill out the form below and someone will contact you.</p>
          </div>
          <div id="w-node-_732bcef8-8d83-7c8b-49b6-bdaaeaec745a-08125e52" class="section-heading-container no-margin-bottom">
            <div class="section-heading-content">
              <div class="dot"></div>
              <h1 class="text-s">Contact</h1>
            </div>
          </div>
        </div>
      </div>
    </div>

  <div class="wf-section">
      <div class="wf-container">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-f6d67567-19b4-0507-7f79-0cc269e1b956-08125e52" class="from-block w-form">
            <form id="email-form" name="email-form" data-name="Email Form" method="get" class="form" data-wf-page-id="64beea3c9843812b08125e52" data-wf-element-id="f6d67567-19b4-0507-7f79-0cc269e1b957"><label for="First-Name" class="wf-field-label">First Name</label><input class="text-field w-input" maxlength="256" name="First-Name" data-name="First Name" placeholder="First Name" type="text" id="First-Name" required="" /><label for="Last-Name" class="wf-field-label">Last Name</label><input class="text-field w-input" maxlength="256" name="Last-Name" data-name="Last Name" placeholder="Last Name" type="text" id="Last-Name" required="" /><label for="Email-3" class="wf-field-label">Email</label><input class="text-field w-input" maxlength="256" name="Email" data-name="Email" placeholder="Your email" type="email" id="Email-3" required="" /><label for="Project" class="wf-field-label">Tell Us About The Project (Scope, Timeline, Budget)</label><textarea placeholder="Tell us about your project" maxlength="5000" id="Project" name="Project" required="" data-name="Project" class="text-field text-area w-input"></textarea><input type="submit" data-wait="Please wait..." class="submit-button w-button" value="Submit your message" /></form>
            <div class="w-form-done">
              <div>Thank you! Your submission has been received!</div>
            </div>
            <div class="w-form-fail">
              <div>Oops! Something went wrong while submitting the form.</div>
            </div>
          </div>
          <div id="w-node-_3c218da5-acea-014a-4d03-5a53c762b04c-08125e52">
            <div class="margin-bottom-16">
              <p>Address</p>
              <p class="light-grey-text">Montgomery,<br />Alabama</p>
            </div>
            <div class="margin-bottom-16">
              <p>Contact</p>
              <p class="light-grey-text">info@ebertdesign.co<br /></p>
            </div>
            <div>
              <p>Pro Bono</p>
              <p class="light-grey-text text-s margin-bottom-16">At any given moment, Ebert Design balances paid and pro-bono engagements. If you would like to be considered for pro bono services, please email us with the below address. You must provide proof of 501(c)3 status.</p>
              <p class="light-grey-text">probono@ebertdesign.co<br /></p>
            </div>
          </div>
        </div>
      </div>
    </div>
</BaseLayout>
