---
/**
 * /contact. Sections are `Wrapper/Section`, labels `Typography/Eyebrow`, buttons
 * `Button`; the entrance animations play through `Utility/Reveal` rather than
 * Webflow's IX2, and the chrome comes from `BaseLayout`.
 * What is still the export's own is the twelve-column grid (`_12-column-grid`
 * and the `#w-node-…` placements it needs) and the site's utility classes —
 * both deliberate: they are this design's layout system, and the framework's
 * `Grid` expresses column counts rather than named areas.
 *
 * Webflow widgets still in this markup, non-functional until pass 2: w-form.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Form from "@/components/Form/Form.astro";
import Input from "@/components/Form/Input.astro";
import Textarea from "@/components/Form/Textarea.astro";
import Button from "@/components/Button.astro";
import Section from "@/components/Wrapper/Section.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
---

<BaseLayout
  title="Contact"
>
  <Section paddingTop="none" paddingBottom="none" class="subpage-hero-section" gap="0">
        <div class="w-layout-grid _12-column-grid hero-grid fade-in-bottom">
          <div id="w-node-_490b76ab-b07c-0ba2-dfe3-385728885767-08125e52">
            <p class="text-5xl margin-bottom-16">Work with us today.</p>
            <p class="text-large">Ready to work together? Fill out the form below and someone will contact you.</p>
          </div>
          <Eyebrow id="w-node-_732bcef8-8d83-7c8b-49b6-bdaaeaec745a-08125e52" tag="h1" class="no-margin-bottom">Contact</Eyebrow>
        </div>
  </Section>

  <Section paddingTop="none" gap="0">
        <div class="w-layout-grid _12-column-grid">
          <div id="w-node-f6d67567-19b4-0507-7f79-0cc269e1b956-08125e52" class="from-block w-form">
            <Form
          name="Contact"
          successMessage="Thank you! Your submission has been received!"
          errorMessage="Oops! Something went wrong while submitting the form."
        >
          <Input variant="first-name" name="First-Name" label="First Name" placeholder="First Name" required />
          <Input variant="last-name" name="Last-Name" label="Last Name" placeholder="Last Name" required />
          <Input variant="email" name="Email" label="Email" placeholder="Your email" required />
          <Textarea
            name="Project"
            label="Tell Us About The Project (Scope, Timeline, Budget)"
            placeholder="Tell us about your project..."
            required
          />
          <Button element="button" type="submit" class="submit">Submit your message</Button>
        </Form>

          </div>
          <div id="w-node-_3c218da5-acea-014a-4d03-5a53c762b04c-08125e52">
            <div class="margin-bottom-16">
              <p>Address</p>
              <p class="light-grey-text">Montgomery,<br />Alabama</p>
            </div>
            <div class="margin-bottom-16">
              <p>Contact</p>
              <p class="light-grey-text">info@ebertdesign.co<br /></p>
            </div>
            <div>
              <p>Pro Bono</p>
              <p class="light-grey-text text-s margin-bottom-16">At any given moment, Ebert Design balances paid and pro-bono engagements. If you would like to be considered for pro bono services, please email us with the below address. You must provide proof of 501(c)3 status.</p>
              <p class="light-grey-text">probono@ebertdesign.co<br /></p>
            </div>
          </div>
        </div>
  </Section>
</BaseLayout>
