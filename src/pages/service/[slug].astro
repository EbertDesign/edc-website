---
/**
 * PASS 3 — a service, from Sanity. The export's `detail_service.html` with
 * its placeholders bound to the `service` document; deliverables and the
 * related cases come from the same query. Same shared substitutions as every
 * pass-1 page. Becomes Lumos components in pass 2.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SanityImg from "@/components/Media/SanityImg.astro";
import CaseCard from "@/components/Item/CaseCard.astro";
import CtaContact from "@/components/ContentCtaContact.astro";
import { sanityClient, SERVICE_DETAIL_QUERY } from "@/utils/sanity.ts";

export async function getStaticPaths() {
  const { sanityClient, SERVICE_SLUGS_QUERY } = await import("@/utils/sanity.ts");
  const slugs = await sanityClient.fetch(SERVICE_SLUGS_QUERY);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const s = await sanityClient.fetch(SERVICE_DETAIL_QUERY, { slug });
if (!s) throw new Error(`No document for /${Astro.url.pathname}`);
---

<BaseLayout title={s.title} description={s.description ?? undefined} overlap>
  <div class="wf-section">
    <div class="wf-container hero-top-container">
      <div class="hero-image-container">
        <SanityImg image={s.image} loading="eager" class="hero-image" alt="" />
      </div>
      <div class="w-layout-grid _12-column-grid">
        <div class="subpage-hero-text-container fade-in-bottom hero-cell-title">
          <div class="section-heading-container">
            <div class="section-heading-content">
              <div class="dot"></div>
              <p class="text-s">Service</p>
            </div>
          </div>
          <h1>{s.title}</h1>
        </div>
      </div>
    </div>
  </div>

  <div class="wf-section margin-bottom-120">
    <div class="wf-container">
      <div class="w-layout-grid _12-column-grid margin-top-80 fade-in-bottom">
        <p class="text-2xl cell-summary-lead">{s.heading}</p>
        <p class="light-grey-text text-2-columns cell-summary-body">{s.description}</p>
        <p class="text-s light-grey-text margin-top-12 cell-summary-label">About</p>
      </div>
    </div>
  </div>

  <section class="wf-section">
    <div class="wf-container">
      <div class="w-layout-grid _12-column-grid margin-top-80">
        <div class="section-heading-container no-margin-bottom cell-list-label">
          <div class="section-heading-content">
            <div class="dot"></div>
            <h2 class="text-s">Deliverables</h2>
          </div>
        </div>
        <div class="deliverables-container w-dyn-list cell-list-body">
          <div role="list" class="w-dyn-items">
            {(s.deliverables ?? []).map((d) => (
              <div role="listitem" class="deliverable-container w-dyn-item">
                <div class="popup">
                  <SanityImg image={d.image} class="popup_image" sizes="(min-width: 62rem) 50vw, 100vw" />
                  <div class="popup__content">
                    <a href="#" class="popup__close w-inline-block"><img src="/images/X.svg" loading="lazy" alt="" class="popup__icon" /></a>
                    <div class="section-heading-content margin-bottom-64">
                      <div class="dot"></div>
                      <h2 class="text-s">Deliverables</h2>
                    </div>
                    <h2 class="margin-bottom-64">{d.title}</h2>
                    <h5 class="margin-bottom-16">{d.subtitle}</h5>
                    <p class="light-grey-text">{d.description}</p>
                  </div>
                </div>
                <a href={`/deliverables/${d.slug}`} class="deliverables-list-container w-inline-block">
                  <p class="text-xl">{d.title}</p>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {s.cases && s.cases.length > 0 && (
    <div class="wf-section">
      <div class="wf-container">
        <div class="w-layout-grid _12-column-grid">
          <p class="text-4xl fade-in-bottom cell-next-lead">See for yourself</p>
          <div class="section-heading-container no-margin-bottom cell-next-label">
            <div class="section-heading-content">
              <div class="dot"></div>
              <h2 class="text-s">Related cases</h2>
            </div>
          </div>
          <div class="projects w-dyn-list cell-next-body">
            <div role="list" class="projects-list w-dyn-items">
              {s.cases.map((c) => (
                <CaseCard case={c} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <CtaContact />
</BaseLayout>
