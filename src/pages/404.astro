---
/**
 * /404. Sections are `Wrapper/Section`, labels `Typography/Eyebrow`, buttons
 * `Button`; the entrance animations play through `Utility/Reveal` rather than
 * Webflow's IX2, and the chrome comes from `BaseLayout`.
 * What is still the export's own is the twelve-column grid (`_12-column-grid`
 * and the `#w-node-…` placements it needs) and the site's utility classes —
 * both deliberate: they are this design's layout system, and the framework's
 * `Grid` expresses column counts rather than named areas.
 *
 * Webflow widgets still in this markup, non-functional until pass 2: w-form.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="Not Found"
>
  <div class="utility-page-wrap">
      <div class="utility-page-content w-form">
        <h2 class="text-2xl margin-bottom-48">Oops!<br />Nothing is here.</h2>
        <div class="utility-form-text">The page you are looking for doesn&#x27;t exist or has been moved</div>
        <Button element="link" href="#">Take me home</Button>
      </div>
    </div>
</BaseLayout>
