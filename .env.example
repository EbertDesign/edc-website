# Adobe Fonts (Typekit) web project serving Aktiv Grotesk.
# The ID is the filename in the kit's embed code:
#   <link rel="stylesheet" href="https://use.typekit.net/<id>.css">
# Leave it unset and the kit <link> is omitted — `--font-grotesk` then falls
# through to Helvetica, which is the intended fallback, not a broken state.
PUBLIC_ADOBE_FONTS_KIT_ID=
